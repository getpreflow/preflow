{
    "key": "page",
    "table": "page",
    "storage": "json",
    "id_field": "uuid",
    "label": "Pages",
    "fields": {
        "title": { "type": "string", "translatable": true, "validate": ["required"] },
        "slug": { "type": "string", "translatable": true, "validate": ["required"] },
        "cover": { "type": "asset", "label": "Cover image", "help": "Upload an image; stored under the Folio uploads dir.", "asset": { "multiple": false, "accept": "image/*" } },
        "author": { "type": "relation", "label": "Author", "help": "Pick an author record.", "relation": { "to": "author", "multiple": false } },
        "sections": { "type": "blocks", "label": "Sections", "help": "Inline blocks owned by this page.", "allowed": ["hero"] },
        "blocks": { "type": "matrix", "label": "Content blocks", "help": "Compose this page from Note records, in order.", "matrix": { "allowed": ["note"] } },
        "body": { "type": "richtext", "translatable": true, "label": "Body content", "help": "Rich text — formatting is preserved and sanitized on save." },
        "status": { "type": "select", "options": { "draft": "Draft", "published": "Published" }, "validate": ["required"] }
    }
}
