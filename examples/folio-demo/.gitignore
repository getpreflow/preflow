# Runtime records seeded/created by the demo — keep the dir, ignore its contents.
storage/data/*
!storage/data/.gitkeep

# Runtime uploads (asset field) created through the admin — keep the dir, ignore contents.
storage/uploads/*
!storage/uploads/.gitkeep

# Runtime caches (e.g. the block registry) — rebuilt automatically.
storage/cache/*

# Cron lock for folio:publish-scheduled.
storage/locks/
