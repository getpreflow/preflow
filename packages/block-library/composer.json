{
    "name": "preflow/block-library",
    "description": "Preflow block library — ready-made blocks a site switches on and restyles: columns (a column layout from a site-defined list)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/blocks": "^0.92.0 || @dev",
        "preflow/components": "^0.91.0 || @dev",
        "preflow/core": "^0.91.0 || @dev",
        "preflow/i18n": "^0.91.0 || @dev",
        "preflow/view": "^0.91.0 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/blade": "^0.91.0 || @dev",
        "preflow/twig": "^0.91.0 || @dev"
    },
    "conflict": {
        "preflow/blocks": "<0.92.0",
        "preflow/components": "<0.91.0",
        "preflow/core": "<0.91.0",
        "preflow/i18n": "<0.91.0",
        "preflow/view": "<0.91.0"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\BlockLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\BlockLibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "blocks": [
                "Preflow\\BlockLibrary\\Columns\\Columns"
            ],
            "translations": {
                "block-library": { "path": "lang", "scope": "public" }
            }
        }
    }
}
