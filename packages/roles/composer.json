{
    "name": "preflow/roles",
    "description": "Preflow roles — simple roles from config/roles.php answering can()",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/auth": "^0.18 || @dev",
        "preflow/core": "^0.18 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Roles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Roles\\Tests\\": "tests/"
        }
    }
}
