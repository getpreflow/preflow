{% extends "_layout.twig" %}

{% block title %}{{ t('app.error.title', { status: status|default(404) }) }}{% endblock %}

{% block content %}
<h1>{{ status|default(404) }}</h1>
<p class="error-message">{{ message|default('Page not found') }}</p>
<p><a href="{{ locale_url('/') }}">{{ t('app.error.home') }}</a></p>

{% apply css %}
.error-message { color: var(--muted); margin: 0.5rem 0 1rem; }
{% endapply %}
{% endblock %}
