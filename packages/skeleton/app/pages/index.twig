{% extends "_layout.twig" %}

{% block title %}{{ t('app.home.title') }}{% endblock %}

{% block content %}
{% do seo({ title: t('app.home.title'), description: t('app.home.seo_description') }) %}

<h1>{{ t('app.home.title') }}</h1>
<p class="lead">{{ t('app.home.lead') }}</p>

<h2>{{ t('app.home.next') }}</h2>

<section class="step">
    <h3>1. {{ t('app.home.page_title') }}</h3>
    <p>{{ t('app.home.page_text') }}</p>
</section>

<section class="step">
    <h3>2. {{ t('app.home.admin_title') }}</h3>
    <p>{{ t('app.home.admin_text') }}</p>
    <pre><code>composer require preflow/folio preflow/rbac
php preflow folio:install</code></pre>
    <p class="hint">{{ t('app.home.admin_hint') }}</p>
</section>

{% apply css %}
.lead { color: var(--muted); margin-top: 0.5rem; }
h2 { margin-top: 2rem; font-size: 1.2rem; }
.step { margin-top: 1rem; padding: 1rem; background: var(--card); border: 1px solid var(--line); border-radius: 0.5rem; }
.step h3 { font-size: 1rem; margin-bottom: 0.25rem; }
.step pre { margin-top: 0.75rem; padding: 0.75rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 0.25rem; }
.hint { margin-top: 0.75rem; color: var(--muted); font-size: 0.875rem; }
{% endapply %}
{% endblock %}
