<!DOCTYPE html>
<html lang="{{ current_locale() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %}</title>
    {# SEO adds <meta name="description"> and the share cards: a page sets the text with {% do seo({description: '…'}) %}. #}
</head>
<body>
    <header class="site-header">
        <a href="{{ locale_url('/') }}" class="site-brand">{{ t('app.name') }}</a>
        <nav class="site-nav" aria-label="{{ t('app.language') }}">
            {% for code in available_locales() %}
                {% if code == current_locale() %}
                    <span aria-current="true">{{ code|upper }}</span>
                {% else %}
                    <a href="{{ locale_url('/', code) }}" hreflang="{{ code }}">{{ code|upper }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    </header>

    <main class="site-main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">{{ t('app.footer') }}</footer>
</body>
</html>

{% apply css %}
:root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #1f2933;
    --muted: #616e7c;
    --line: #e4e7eb;
    --accent: #0b6bcb;
    --card: #f9fafb;
}

@media (prefers-color-scheme: dark) {
    :root {
        --bg: #12161b;
        --text: #e4e7eb;
        --muted: #9aa5b1;
        --line: #2d343c;
        --accent: #6cb2f5;
        --card: #181d23;
    }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.site-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
}

.site-brand { color: var(--text); font-weight: 700; text-decoration: none; }
.site-nav { display: flex; gap: 0.75rem; font-size: 0.875rem; }
.site-nav [aria-current] { font-weight: 700; }

.site-main {
    flex: 1;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.site-footer {
    padding: 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--line);
}

a { color: var(--accent); }
h1 { font-size: 1.75rem; line-height: 1.25; }
code { font-size: 0.9em; }
{% endapply %}
