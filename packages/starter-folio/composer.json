{
    "name": "preflow/starter-folio",
    "description": "Preflow Jobs with Folio: the job board starter with a content admin for staff, on SQLite",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.73",
        "preflow/routing": "^0.73",
        "preflow/view": "^0.73",
        "preflow/twig": "^0.73",
        "preflow/components": "^0.73",
        "preflow/htmx": "^0.73",
        "preflow/i18n": "^0.73",
        "preflow/data": "^0.73",
        "preflow/auth": "^0.73",
        "preflow/validation": "^0.73",
        "preflow/form": "^0.73",
        "preflow/folio": "^0.73",
        "preflow/blocks": "^0.73",
        "preflow/publishing": "^0.73",
        "preflow/media": "^0.73",
        "preflow/rbac": "^0.73",
        "preflow/notify": "^0.73",
        "preflow/devtools": "^0.73",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "league/commonmark": "^2.5"
    },
    "require-dev": {
        "preflow/testing": "^0.73",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\"",
            "@php preflow key:generate",
            "@php preflow migrate",
            "@php preflow rbac:install",
            "@php preflow folio:extensions:apply",
            "@php preflow db:seed"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpunit"
        ]
    }
}
