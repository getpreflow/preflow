<div class="hero__text">
    <h1{{ folio_editable('headline') }}>{{ headline }}</h1>
    {% if intro %}<p class="hero__intro"{{ folio_editable('intro') }}>{{ intro }}</p>{% endif %}
    {# Only site paths and web addresses: a javascript: link typed into the field is not printed. #}
    {% if cta_label and cta_url matches '{^(/|https?://)}' %}
        <p><a class="hero__cta" href="{{ cta_url }}"{{ folio_editable('cta_label') }}>{{ cta_label }}</a></p>
    {% endif %}
</div>
{% if image %}<div class="hero__image">{{ media_image(image, 'hero') }}</div>{% endif %}

{% apply css %}
/* "&" is the block's own element: the CSS is nested inside its scoped class. */
& {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
}
@media (min-width: 48rem) {
    &:has(.hero__image) { grid-template-columns: 3fr 2fr; }
}
.hero__intro { color: var(--muted); margin-top: 0.5rem; font-size: 1.1rem; }
.hero__cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    font-weight: 600;
}
.hero__image img { width: 100%; height: auto; border-radius: 0.5rem; display: block; }
{% endapply %}
