<p class="job-results__count" role="status">{{ t(total == 1 ? 'app.search.count_one' : 'app.search.count', { count: total }) }}</p>
{% if jobs %}
    <div class="{{ view == 'list' ? 'job-list' : 'job-grid' }}">
        {% for job in jobs %}
            {{ component('JobCard', { job: job, view: view, key: job.id }) }}
        {% endfor %}
    </div>
{% else %}
    <p class="job-results__empty">{{ t('app.search.empty') }} <a href="/jobs">{{ t('app.search.clear') }}</a></p>
{% endif %}

{% apply css %}
.job-results__count { color: var(--muted); font-size: 0.9rem; margin-bottom: 0.5rem; }
.job-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
}
.job-list { display: grid; gap: 0.4rem; }
.job-results__empty { color: var(--muted); }
{% endapply %}
