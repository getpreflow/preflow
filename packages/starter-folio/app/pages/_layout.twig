<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %}</title>
    {# SEO adds <meta name="description"> and the share cards: a page sets the text with {% do seo({description: '…'}) %}. #}
</head>
<body>
    <header class="site-header">
        <a href="/" class="site-brand">{{ t('app.name') }}</a>
        <nav class="site-nav">
            <a href="/jobs">{{ t('app.nav.jobs') }}</a>
            <a href="/news">{{ t('app.nav.news') }}</a>
            <a href="/employer">{{ t('app.nav.employers') }}</a>
            <a href="/api/jobs">{{ t('app.nav.api') }}</a>
        </nav>
    </header>

    <main class="site-main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        {{ t('app.footer') }} &middot; <a href="/about-error-boundaries">{{ t('app.footer_errors') }}</a>
    </footer>
</body>
</html>

{% apply css %}
:root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #1f2933;
    --muted: #616e7c;
    --line: #e4e7eb;
    --accent: #0b6bcb;
    --card: #f9fafb;
    --warn-bg: #fff8f0;
    --warn-line: #f0c040;
}

@media (prefers-color-scheme: dark) {
    :root {
        --bg: #12161b;
        --text: #e4e7eb;
        --muted: #9aa5b1;
        --line: #2d343c;
        --accent: #6cb2f5;
        --card: #181d23;
        --warn-bg: #2a2416;
        --warn-line: #7a6320;
    }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.site-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
}

.site-nav { display: flex; gap: 1.25rem; }
.site-nav a { text-decoration: none; }
.site-nav a:hover { text-decoration: underline; }

.site-brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
}

.site-main {
    flex: 1;
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
}

.site-footer {
    padding: 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--line);
}

a { color: var(--accent); }
h1 { font-size: 1.75rem; line-height: 1.25; }
code { font-size: 0.9em; }
{% endapply %}
