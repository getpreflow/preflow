{#- The site's base CSS: the page layout and Folio's job preview canvas both include it. -#}
{% apply css %}
:root {
    color-scheme: light dark;
    --bg: #ffffff;
    --text: #1f2933;
    --muted: #616e7c;
    --line: #e4e7eb;
    --accent: #0b6bcb;
    --card: #f9fafb;
    --warn-bg: #fff8f0;
    --warn-line: #f0c040;
}

@media (prefers-color-scheme: dark) {
    :root {
        --bg: #12161b;
        --text: #e4e7eb;
        --muted: #9aa5b1;
        --line: #2d343c;
        --accent: #6cb2f5;
        --card: #181d23;
        --warn-bg: #2a2416;
        --warn-line: #7a6320;
    }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.site-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
}

.site-nav { display: flex; gap: 1.25rem; }
.site-nav a { text-decoration: none; }
.site-nav a:hover { text-decoration: underline; }

.site-brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
}

.site-main {
    flex: 1;
    width: 100%;
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
}

.site-footer {
    padding: 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--line);
}

a { color: var(--accent); }
h1 { font-size: 1.75rem; line-height: 1.25; }
code { font-size: 0.9em; }
{% endapply %}
