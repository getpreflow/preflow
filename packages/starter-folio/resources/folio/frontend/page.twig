{#- A Folio page (config/models/page.json): its sections are blocks, each rendered by its component
    in app/Components/Blocks. In the editor's live preview, preview is true and the blocks are
    marked for click-to-edit. -#}
{% extends "_layout.twig" %}

{% block title %}{{ record.slug == 'home' ? t('app.name') : record.title ~ ' · ' ~ t('app.name') }}{% endblock %}

{% block content %}
{{ blocks(record.sections|default([]), preview|default(false)) }}
{% endblock %}
