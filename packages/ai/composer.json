{
    "name": "preflow/ai",
    "description": "Preflow AI — a small provider-neutral client for text and JSON completions (Claude, Gemini)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.38 || @dev",
        "anthropic-ai/sdk": "^1.2",
        "symfony/http-client": "^7.3 || ^8.0",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/devtools": "^0.34 || @dev"
    },
    "conflict": {
        "preflow/core": "<0.38"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Ai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Ai\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "translations": {
                "ai": {
                    "path": "lang",
                    "scope": "admin"
                }
            },
            "commands": [
                "Preflow\\Ai\\Console\\AiCheckCommand",
                "Preflow\\Ai\\Console\\AiUsageCommand"
            ]
        }
    },
    "suggest": {
        "preflow/devtools": "The ai:check and ai:usage commands",
        "preflow/i18n": "Admin UI texts of this package"
    }
}
