<h3 class="job-card__title">
    <a class="job-card__link" href="/jobs/{{ job.slug }}">{{ job.title }}</a>
</h3>
<p class="job-card__company">
    {% if job.company %}{{ job.company.name }}{% endif %}{% if job.place %} &middot; {{ job.place }}{% endif %}
</p>
<p class="job-card__meta">
    <span class="job-card__tag">{{ t('app.type.' ~ job.employment_type) }}</span>
    {% if job.remote != 'no' %}<span class="job-card__tag">{{ t('app.remote.' ~ job.remote) }}</span>{% endif %}
    {% if job.salary %}
        <span class="job-card__salary">{{ job.salary.currency }}
            {% if job.salary.from and job.salary.to %}{{ job.salary.from|number_format(0, '.', ',') }} &ndash; {{ job.salary.to|number_format(0, '.', ',') }}
            {% elseif job.salary.from %}{{ t('app.salary_from') }} {{ job.salary.from|number_format(0, '.', ',') }}
            {% else %}{{ t('app.salary_up_to') }} {{ job.salary.to|number_format(0, '.', ',') }}{% endif %}
        </span>
    {% endif %}
</p>

{% apply css %}
.job-card {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--card);
}

.job-card__title { font-size: 1.05rem; line-height: 1.3; }
.job-card__link { color: var(--text); text-decoration: none; }
.job-card__link:hover { color: var(--accent); text-decoration: underline; }
.job-card__company { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
.job-card__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: 0.6rem; font-size: 0.85rem; }
.job-card__tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    color: var(--muted);
}
.job-card__salary { color: var(--muted); }
{% endapply %}
