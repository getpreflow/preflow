<h3 class="job-card__title">
    <a class="job-card__link" href="/jobs/{{ job.slug }}">{{ job.title }}</a>
</h3>
<p class="job-card__company">
    {% if job.company %}{{ job.company.name }}{% endif %}{% if job.place %} &middot; {{ job.place }}{% endif %}
</p>
<p class="job-card__meta">
    <span class="job-card__tag">{{ t('app.type.' ~ job.employment_type) }}</span>
    {% if job.remote != 'no' %}<span class="job-card__tag">{{ t('app.remote.' ~ job.remote) }}</span>{% endif %}
    {% if job.salary %}
        {# 0 is a salary too, so the checks are "is not null", not truthiness. #}
        <span class="job-card__salary">{{ job.salary.currency }}
            {% if job.salary.from is not null and job.salary.to is not null %}{{ job.salary.from|number_format(0, '.', ',') }} &ndash; {{ job.salary.to|number_format(0, '.', ',') }}
            {% elseif job.salary.from is not null %}{{ t('app.salary_from') }} {{ job.salary.from|number_format(0, '.', ',') }}
            {% else %}{{ t('app.salary_up_to') }} {{ job.salary.to|number_format(0, '.', ',') }}{% endif %}
        </span>
    {% endif %}
</p>

{% apply css %}
/* The card itself: "&" is the wrapper, the CSS is nested inside its scoped class. */
& {
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--card);
}

.job-card__title { font-size: 1.05rem; line-height: 1.3; }
.job-card__link { color: var(--text); text-decoration: none; }
.job-card__link:hover { color: var(--accent); text-decoration: underline; }
.job-card__company { color: var(--muted); font-size: 0.9rem; margin-top: 0.25rem; }
.job-card__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; margin-top: 0.6rem; font-size: 0.85rem; }
.job-card__tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    color: var(--muted);
}
.job-card__salary { color: var(--muted); }

/* The list variant: one compact row, title and company on the left, the facts on the right. */
&[data-view="list"] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.75rem;
    padding: 0.5rem 0.75rem;
    border-width: 0 0 1px;
    border-radius: 0;
    background: none;
}
&[data-view="list"] .job-card__title { font-size: 1rem; }
&[data-view="list"] .job-card__company { margin-top: 0; }
&[data-view="list"] .job-card__meta { margin: 0 0 0 auto; font-size: 0.8rem; }
{% endapply %}
