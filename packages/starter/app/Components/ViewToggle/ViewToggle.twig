<legend class="view-toggle__legend">{{ t('app.search.view') }}</legend>
{% for option in ['cards', 'list'] %}
    <label class="view-toggle__option">
        <input class="view-toggle__input" type="radio" name="view" value="{{ option }}"{% if option == view %} checked{% endif %}>
        <span class="view-toggle__text">{{ t('app.search.' ~ option) }}</span>
    </label>
{% endfor %}

{% apply css %}
& { border: 0; display: flex; align-items: center; gap: 0; }
.view-toggle__legend { float: left; margin-right: 0.5rem; font-size: 0.9rem; color: var(--muted); }
.view-toggle__option { position: relative; }
.view-toggle__input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.view-toggle__text {
    display: inline-block;
    border: 1px solid var(--line);
    padding: 0.1rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
}
.view-toggle__option:first-of-type .view-toggle__text { border-radius: 0.5rem 0 0 0.5rem; }
.view-toggle__option:last-of-type .view-toggle__text { border-radius: 0 0.5rem 0.5rem 0; border-left: 0; }
.view-toggle__input:checked + .view-toggle__text { background: var(--accent); border-color: var(--accent); color: var(--bg); }
.view-toggle__input:focus-visible + .view-toggle__text { outline: 2px solid var(--accent); outline-offset: 2px; }
{% endapply %}
