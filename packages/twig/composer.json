{
    "name": "preflow/twig",
    "description": "Preflow Twig adapter — Twig template engine implementation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.60 || @dev",
        "preflow/view": "^0.72 || @dev",
        "preflow/components": "^0.1 || @dev",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "preflow/htmx": "Required for HdExtension (hd.post, hd.get helpers)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/testing": "^0.64 || @dev"
    },
    "conflict": {
        "preflow/core": "<0.60",
        "preflow/view": "<0.72"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Twig\\Tests\\": "tests/"
        }
    }
}
