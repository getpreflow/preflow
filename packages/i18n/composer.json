{
    "name": "preflow/i18n",
    "description": "Preflow i18n — translations, locale detection, pluralization",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.83.0 || @dev"
    },
    "conflict": {
        "preflow/ai": "<0.78",
        "preflow/core": "<0.83.0",
        "preflow/testing": "<0.83.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8",
        "preflow/devtools": "^0.34 || @dev",
        "preflow/ai": "^0.78 || @dev"
    },
    "suggest": {
        "preflow/ai": "Machine translation (AiTranslator, translate:plan and translate:work, Folio's Translate); without it machine translation is never offered",
        "preflow/devtools": "The translations:check command"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\I18n\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\I18n\\Console\\TranslationsCheckCommand",
                "Preflow\\I18n\\Console\\TranslateWorkCommand",
                "Preflow\\I18n\\Console\\TranslatePlanCommand"
            ]
        }
    }
}
