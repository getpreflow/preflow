{
    "name": "preflow/i18n",
    "description": "Preflow i18n — translations, locale detection, pluralization",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.1 || @dev",
        "preflow/ai": "^0.47 || @dev"
    },
    "conflict": {
        "preflow/ai": "<0.47"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8",
        "preflow/devtools": "^0.34 || @dev"
    },
    "suggest": {
        "preflow/devtools": "The translations:check command"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\I18n\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\I18n\\Console\\TranslationsCheckCommand",
                "Preflow\\I18n\\Console\\TranslateWorkCommand"
            ]
        }
    }
}
