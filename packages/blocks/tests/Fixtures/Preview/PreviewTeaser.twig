<article class="teaser" data-type="{{ type }}" data-view="{{ view }}" data-locale="{{ locale }}" data-preview="{{ flag }}" data-props="{{ propNames }}"><h2>{{ record.title }}</h2></article>
{% apply css %}.teaser { color: rebeccapurple; }{% endapply %}
{% apply js %}window.teaserLoaded = true;{% endapply %}
