{
    "name": "preflow/rbac",
    "description": "Preflow RBAC — roles managed in Folio answering can()",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/auth": "^0.69 || @dev",
        "preflow/core": "^0.27 || @dev",
        "preflow/data": "^0.20 || @dev",
        "preflow/devtools": "^0.26 || @dev",
        "preflow/folio": "^0.69 || @dev",
        "preflow/i18n": "^0.37 || @dev",
        "preflow/notify": "^0.68 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "conflict": {
        "preflow/auth": "<0.69",
        "preflow/core": "<0.27",
        "preflow/data": "<0.69",
        "preflow/folio": "<0.69",
        "preflow/i18n": "<0.37",
        "preflow/notify": "<0.68"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Rbac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "folio": {
            "extension": "Preflow\\Rbac\\Extension"
        },
        "preflow": {
            "commands": [
                "Preflow\\Rbac\\Console\\InstallCommand",
                "Preflow\\Rbac\\Console\\RolesCommand",
                "Preflow\\Rbac\\Console\\RoleCommand",
                "Preflow\\Rbac\\Console\\RoleDeleteCommand",
                "Preflow\\Rbac\\Console\\StaffListCommand",
                "Preflow\\Rbac\\Console\\StaffCreateCommand",
                "Preflow\\Rbac\\Console\\StaffPasswordCommand",
                "Preflow\\Rbac\\Console\\StaffInviteCommand",
                "Preflow\\Rbac\\Console\\StaffResetCommand",
                "Preflow\\Rbac\\Console\\StaffDisableCommand",
                "Preflow\\Rbac\\Console\\StaffEnableCommand",
                "Preflow\\Rbac\\Console\\ImportConfigStaffCommand",
                "Preflow\\Rbac\\Console\\ImportConfigStaffAliasCommand"
            ],
            "translations": {
                "rbac": { "path": "lang", "scope": "admin" },
                "rbac-mail": { "path": "lang", "scope": "admin" }
            }
        }
    }
}
