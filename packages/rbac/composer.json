{
    "name": "preflow/rbac",
    "description": "Preflow RBAC — stored roles answering can(), staff accounts and their commands; Folio adds their admin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/auth": "^0.69 || @dev",
        "preflow/core": "^0.62 || @dev",
        "preflow/data": "^0.69 || @dev",
        "preflow/i18n": "^0.37 || @dev",
        "preflow/notify": "^0.69 || @dev",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/devtools": "^0.26 || @dev",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "preflow/devtools": "The rbac:* and staff:* commands (php preflow)",
        "preflow/folio": "The admin of roles and staff accounts (Folio's built-in extension \"rbac\")"
    },
    "conflict": {
        "preflow/auth": "<0.69",
        "preflow/core": "<0.62",
        "preflow/data": "<0.69",
        "preflow/devtools": "<0.26",
        "preflow/folio": "<0.69",
        "preflow/i18n": "<0.37",
        "preflow/notify": "<0.69"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Rbac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\Rbac\\Console\\InstallCommand",
                "Preflow\\Rbac\\Console\\RolesCommand",
                "Preflow\\Rbac\\Console\\RoleCommand",
                "Preflow\\Rbac\\Console\\RoleDeleteCommand",
                "Preflow\\Rbac\\Console\\StaffListCommand",
                "Preflow\\Rbac\\Console\\StaffCreateCommand",
                "Preflow\\Rbac\\Console\\StaffPasswordCommand",
                "Preflow\\Rbac\\Console\\StaffInviteCommand",
                "Preflow\\Rbac\\Console\\StaffResetCommand",
                "Preflow\\Rbac\\Console\\StaffDisableCommand",
                "Preflow\\Rbac\\Console\\StaffEnableCommand",
                "Preflow\\Rbac\\Console\\ImportConfigStaffCommand"
            ],
            "translations": {
                "rbac": { "path": "lang", "scope": "admin" },
                "rbac-mail": { "path": "lang", "scope": "admin" }
            }
        }
    }
}
