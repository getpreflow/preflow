{
    "name": "preflow/rbac",
    "description": "Preflow RBAC — roles managed in Folio answering can()",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/auth": "^0.20 || @dev",
        "preflow/core": "^0.20 || @dev",
        "preflow/data": "^0.20 || @dev",
        "preflow/folio": "^0.20 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Rbac\\Tests\\": "tests/"
        }
    },
    "extra": {
        "folio": {
            "extension": "Preflow\\Rbac\\Extension"
        }
    }
}
