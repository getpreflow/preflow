{
    "key": "staff",
    "table": "staff",
    "storage": "default",
    "id_field": "uuid",
    "label": "Staff",
    "publishing": false,
    "fields": {
        "email": { "type": "string", "validate": ["required"] },
        "name": { "type": "string" },
        "password_hash": { "type": "string", "hidden": true, "searchable": false },
        "roles": { "type": "list" },
        "active": { "type": "boolean", "default": true },
        "auth_epoch": { "type": "string", "hidden": true, "searchable": false, "default": "0" },
        "last_login_at": { "type": "date", "time": true },
        "created_at": { "type": "date", "time": true }
    }
}
