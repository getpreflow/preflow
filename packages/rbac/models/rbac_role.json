{
    "key": "rbac_role",
    "table": "rbac_role",
    "storage": "default",
    "id_field": "uuid",
    "label": "Roles",
    "publishing": false,
    "fields": {
        "name": { "type": "string", "validate": ["required", "regex:/^[a-z][a-z0-9_-]*$/"] },
        "label": { "type": "string", "validate": ["required"] },
        "population": { "type": "select", "options": { "staff": "Staff", "members": "Members" }, "validate": ["required", "in:staff,members"] },
        "permissions": { "type": "list" },
        "seeded_permissions": { "type": "text", "hidden": true }
    }
}
