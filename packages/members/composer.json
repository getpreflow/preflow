{
    "name": "preflow/members",
    "description": "Preflow members — member accounts for a Preflow site: registration, sign-in, the account page, pluggable admission; Folio adds the admin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "nyholm/psr7": "^1.8",
        "preflow/auth": "^0.26 || @dev",
        "preflow/core": "^0.25 || @dev",
        "preflow/data": "^0.26 || @dev",
        "preflow/devtools": "^0.26 || @dev",
        "preflow/i18n": "^0.37 || @dev",
        "preflow/notify": "^0.25 || @dev",
        "preflow/routing": "^0.25 || @dev",
        "preflow/validation": "^0.26 || @dev",
        "preflow/view": "^0.25 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "preflow/folio": "The members admin: the Members list, the owner's decision panel and Settings → Members (Folio carries it when this package is installed)",
        "preflow/rbac": "Roles and permissions beyond members.access (Folio's members admin needs it)"
    },
    "conflict": {
        "preflow/auth": "<0.26",
        "preflow/data": "<0.26",
        "preflow/folio": "<0.37",
        "preflow/i18n": "<0.37"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Members\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Members\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\Members\\Console\\PruneMembersCommand",
                "Preflow\\Members\\Console\\DecideCommand"
            ],
            "translations": {
                "members": { "path": "lang", "scope": "public" },
                "members-admin": { "path": "lang", "scope": "admin" }
            }
        }
    }
}
