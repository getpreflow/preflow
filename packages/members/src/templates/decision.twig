{# The Decision panel (side column): state, a one-line summary with the admission's details, then Accept / Decline with an editable message. #}
<p><span class="folio-badge{% if state_tone %} is-{{ state_tone }}{% endif %}">{{ state_label }}</span></p>
<p class="folio-help">{{ t('members-admin.decision.registered', {date: registered}) }}{% for line in details %} · {{ line }}{% endfor %}</p>

{% if state == 'unconfirmed' %}
    <p class="folio-help">{{ t('members-admin.decision.unconfirmed') }}</p>
{% else %}
    {% set tabs = [] %}
    {% if can_accept %}{% set tabs = tabs|merge([{key: 'accept', label: t('members-admin.decision.accept'), text: accept_text, button: t('members-admin.decision.accept_send'), style: 'btn-primary'}]) %}{% endif %}
    {% if can_decline %}{% set tabs = tabs|merge([{key: 'decline', label: t('members-admin.decision.decline'), text: decline_text, button: t('members-admin.decision.decline_send'), style: 'btn-secondary'}]) %}{% endif %}
    <div{% if tabs|length > 1 %} data-folio-tabs{% endif %}>
        {% if tabs|length > 1 %}
            <div class="folio-segmented">
                {% for tab in tabs %}<button type="button" data-folio-tab="{{ tab.key }}">{{ tab.label }}</button>{% endfor %}
            </div>
        {% endif %}
        {% for tab in tabs %}
            <div data-folio-tabpanel="{{ tab.key }}">
                <form method="post" action="{{ prefix }}/{{ type }}/{{ id }}/_action/{{ tab.key }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                    <div class="form-group">
                        <label for="decision-{{ tab.key }}">{{ t('members-admin.decision.message_to', {name: record.name ?: record.email}) }}</label>
                        <textarea id="decision-{{ tab.key }}" name="message" rows="12">{{ tab.text }}</textarea>
                        <p class="folio-help">{{ t('members-admin.decision.sent_in', {language: language_label}) }}</p>
                    </div>
                    <button type="submit" class="btn {{ tab.style }}">{{ tab.button }}</button>
                </form>
            </div>
        {% endfor %}
    </div>
{% endif %}
