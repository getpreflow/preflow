{% extends layout %}

{% block meta %}
<title>{{ t('members.label') }}{% if site.name|default('') %} | {{ site.name }}{% endif %}</title>
<meta name="robots" content="noindex">
{% endblock %}

{% block content %}
{# The site's intro (page sections, headline) goes here. #}
{% block intro %}{% endblock %}

<section class="members-form">
  <div class="section-inner">
    {% if warning|default('') %}<p class="members-note" role="alert">{{ warning }}</p>{% endif %}{% if notice %}<p class="members-note" role="status">{{ notice }}</p>{% endif %}
    {% if open %}
    <form class="members-card" method="post" action="{{ base }}/register" novalidate>
      {% if next|default('') %}<input type="hidden" name="next" value="{{ next }}">{% endif %}{{ csrf_field() }}
      {% if errors %}
      <div class="members-errors" role="alert">
        {% if errors.form is defined %}{{ t('members.errors.' ~ errors.form) }}{% else %}{{ t('members.errors.summary') }}{% endif %}
      </div>
      {% endif %}
      <div class="members-row">
        {% if not compose_name|default(false) %}<div class="field{{ errors.name is defined ? ' field--error' : '' }}">
          <label for="f-name">{{ t('members.form.name') }}</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required value="{{ old.name|default('') }}">
          {% if errors.name is defined %}<p class="field-error">{{ t('members.errors.name') }}</p>{% endif %}
        </div>
        {% endif %}<div class="field{{ errors.email is defined ? ' field--error' : '' }}">
          <label for="f-email">{{ t('members.form.email') }}</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required value="{{ old.email|default('') }}">
          {% if errors.email is defined %}<p class="field-error">{{ t('members.errors.email') }}</p>{% endif %}
        </div>
      </div>
      <div class="field{{ errors.password is defined ? ' field--error' : '' }}">
        <label for="f-password">{{ t('members.form.password') }}</label>
        <input id="f-password" name="password" type="password" autocomplete="new-password" minlength="{{ password_min }}" required>
        <p class="field-hint">{{ t('members.form.password_hint', {min: password_min}) }}</p>
        {% if errors.password is defined %}<p class="field-error">{{ t('members.errors.password', {min: password_min}) }}</p>{% endif %}
      </div>
      {# The admission rule's own fields (a code, a question); the site fills this block. #}
      {% block admission_fields %}{% endblock %}
      {# More fields of an extended member type. #}
      {% block extra_fields %}{% endblock %}
      {% include '@members-package/_trap.twig' %}
      <div class="field{{ errors.consent is defined ? ' field--error' : '' }}">
        <label class="members-check" for="f-consent">
          <input id="f-consent" name="consent" type="checkbox" value="1" required{{ old.consent|default(false) ? ' checked' : '' }}>
          {# The privacy page is the site's: config/members.php privacy_url, or override this block. #}
          {% block consent_text %}
          {% set link = privacy_url|default('') ? '<a href="' ~ privacy_url|e('html_attr') ~ '" target="_blank" rel="noopener">' ~ t('members.form.privacy') ~ '</a>' : t('members.form.privacy') %}
          <span>{{ t('members.form.consent')|replace({':link': link})|raw }}</span>
          {% endblock %}
        </label>
        {% if errors.consent is defined %}<p class="field-error">{{ t('members.errors.consent') }}</p>{% endif %}
      </div>
      <button class="btn btn-primary members-submit" type="submit">{{ t('members.form.submit') }}</button>
      <p class="members-switch">{{ t('members.form.registered') }} <a href="{{ base }}/login{{ next_query|default('') }}">{{ t('members.form.login') }}</a></p>
    </form>
    {% else %}
    <div class="members-card">
      <h2>{{ t('members.closed.title') }}</h2>
      <p>{{ t('members.closed.text') }}</p>
      <p class="members-switch"><a href="{{ base }}/login{{ next_query|default('') }}">{{ t('members.form.login') }}</a></p>
    </div>
    {% endif %}
  </div>
</section>
{% apply css %}
{% block members_styles %}
.members-form { color-scheme: light dark; padding: 1.5rem 1rem 4rem; font-family: var(--members-font, inherit); color: var(--members-ink, light-dark(#1a1a1a, #ececec)); }
.members-form > * { max-width: 44rem; margin-left: auto; margin-right: auto; }
.members-card {
  background: var(--members-bg, light-dark(#ffffff, #16181c));
  border: 1px solid var(--members-line, light-dark(#d0d0d0, #3a3f47));
  border-radius: var(--members-radius, 6px);
  padding: 1.25rem;
  display: grid;
  gap: 1rem;
}
.members-card h2 { font-size: 1.5rem; line-height: 1.25; margin: 0; }
.members-card p { margin: 0; }
.members-row { display: grid; grid-template-columns: 1fr; gap: 1rem; }
.members-form .field label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.3rem; }
.members-form .field input[type="text"],
.members-form .field input[type="email"],
.members-form .field input[type="password"],
.members-form .field textarea {
  width: 100%;
  min-height: 2.75rem;
  border: 1px solid var(--members-line, light-dark(#d0d0d0, #3a3f47));
  border-radius: var(--members-radius, 6px);
  background: var(--members-bg, light-dark(#ffffff, #16181c));
  color: var(--members-ink, light-dark(#1a1a1a, #ececec));
  font: inherit;
  font-size: 1rem;
  padding: 0.55rem 0.75rem;
}
.members-form .field textarea { resize: vertical; min-height: 5rem; }
.members-form a:focus-visible,
.members-form button:focus-visible,
.members-form .btn:focus-visible,
.members-form input:focus-visible,
.members-form textarea:focus-visible { outline: 2px solid var(--members-accent, light-dark(#1a1a1a, #ececec)); outline-offset: 2px; }
.members-form .field input:focus-visible,
.members-form .field textarea:focus-visible { border-color: var(--members-accent, light-dark(#1a1a1a, #ececec)); }
.field-hint { font-size: 0.8rem; color: var(--members-muted, light-dark(#5c5c5c, #a8adb5)); margin-top: 0.3rem; }
.field-error { font-size: 0.85rem; color: var(--members-ink, light-dark(#1a1a1a, #ececec)); font-weight: 600; margin-top: 0.3rem; }
.field--error input,
.field--error textarea { border-color: var(--members-accent, light-dark(#1a1a1a, #ececec)); border-width: 2px; }
.members-check { display: flex !important; gap: 0.6rem; align-items: flex-start; font-weight: 400 !important; font-size: 0.875rem !important; color: var(--members-muted, light-dark(#5c5c5c, #a8adb5)); }
.members-check input { margin-top: 0.25rem; accent-color: var(--members-accent, light-dark(#1a1a1a, #ececec)); }
.members-submit { justify-content: center; width: 100%; min-height: 2.75rem; padding: 0.7rem 1rem; }
.members-switch { font-size: 0.875rem; color: var(--members-muted, light-dark(#5c5c5c, #a8adb5)); text-align: center; }
.members-switch a,
.members-form a { color: var(--members-accent, light-dark(#1a1a1a, #ececec)); font-weight: 600; text-decoration: underline; }
.members-errors,
.members-note { border: 1px solid var(--members-accent, light-dark(#1a1a1a, #ececec)); border-left-width: 4px; border-radius: var(--members-radius, 6px); background: var(--members-bg, light-dark(#ffffff, #16181c)); color: var(--members-ink, light-dark(#1a1a1a, #ececec)); font-size: 0.9rem; padding: 0.7rem 0.9rem; }
.members-note { margin-bottom: 1rem; }
@media (min-width: 640px) {
  .members-form { padding: 2rem 1.5rem 6rem; }
  .members-card { padding: 1.75rem 2rem 2rem; }
  .members-row { grid-template-columns: 1fr 1fr; }
}
{% endblock %}
{% endapply %}
{% endblock %}

