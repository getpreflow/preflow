{# The members home for a signed-in member, unless the site has its own page on the members path. #}
{% extends '@members/_card.twig' %}

{% block card %}
<span class="members-status__tag">{{ t('members.label') }}</span>
<h1>{{ t('members.landing.title', {name: name}) }}</h1>
<p>{{ t('members.landing.text') }}</p>
{% if notice %}<p class="members-status__note" role="status">{{ notice }}</p>{% endif %}
<p><a href="{{ base }}/account">{{ t('members.landing.account') }}</a></p>
<form method="post" action="{{ base }}/logout">
  {{ csrf_field() }}
  <button class="btn" type="submit">{{ t('members.landing.logout') }}</button>
</form>
{% endblock %}
