{# The member pages' own page layout, for a site that names none (config/members.php layout):
   a plain standalone page in neutral greys with the custom properties the member templates
   style with (--members-bg, --members-ink, --members-muted, --members-line, --members-accent,
   --members-radius, --members-font; each has a neutral fallback, light and dark). A site
   with its own design names its layout instead (blocks "meta" and "content"). #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% block meta %}<title>{{ t('members.label') }}</title>{% endblock %}
{% for a in alternates %}<link rel="alternate" hreflang="{{ a.locale }}" href="{{ a.href }}">
{% endfor %}
</head>
<body class="members-page">
<main>
{% block content %}{% endblock %}
</main>
{% apply css %}
{% block members_layout_styles %}
*, *::before, *::after { box-sizing: border-box; }
body.members-page {
  color-scheme: light dark;
  margin: 0;
  background: light-dark(#f4f4f4, #0f1114);
  color: var(--members-ink, light-dark(#1a1a1a, #ececec));
  font-family: var(--members-font, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif);
  line-height: 1.5;
}
.members-page .btn { display: inline-flex; align-items: center; border: 1px solid var(--members-accent, light-dark(#1a1a1a, #ececec)); border-radius: var(--members-radius, 6px); background: var(--members-bg, light-dark(#ffffff, #16181c)); color: var(--members-ink, light-dark(#1a1a1a, #ececec)); font: inherit; font-weight: 600; padding: 0.6rem 1rem; text-decoration: none; cursor: pointer; }
.members-page .btn-primary { background: var(--members-accent, light-dark(#1a1a1a, #ececec)); color: var(--members-bg, light-dark(#ffffff, #16181c)); }
{% endblock %}
{% endapply %}
</body>
</html>
