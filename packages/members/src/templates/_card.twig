{# Shared frame of the small status pages (check-inbox, confirm, thanks, login, forgot, reset, resend, account). Extends the configured page layout. #}
{% extends layout %}

{% block meta %}
<title>{{ t('members.label') }}{% if site.name|default('') %} | {{ site.name }}{% endif %}</title>
<meta name="robots" content="noindex">
{% endblock %}

{% block content %}
<section class="members-status">
  <div class="section-inner">
    <div class="members-status__card">
      {% if warning|default('') %}<p class="members-status__note" role="alert">{{ warning }}</p>{% endif %}{% block card %}{% endblock %}
    </div>
  </div>
</section>
{% apply css %}
{% block members_styles %}
.members-status {
  padding: 3rem 1rem 4rem;
  min-height: 60vh;
  font-family: var(--members-font, inherit);
  color: var(--members-ink, light-dark(#1a1a1a, #ececec));
}
.members-status > * { max-width: 34rem; margin-left: auto; margin-right: auto; }
.members-status__card { background: var(--members-bg, light-dark(#ffffff, #16181c)); border: 1px solid var(--members-line, light-dark(#d0d0d0, #3a3f47)); border-radius: var(--members-radius, 6px); padding: 1.5rem; }
.members-status__tag {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--members-muted, light-dark(#5c5c5c, #a8adb5));
  padding: 0.15rem 0.55rem;
  border: 1px solid var(--members-line, light-dark(#d0d0d0, #3a3f47));
  border-radius: var(--members-radius, 6px);
  margin-bottom: 0.8rem;
}
.members-status h1 { font-size: clamp(1.5rem, 4vw, 1.9rem); line-height: 1.25; margin: 0 0 0.8rem; }
.members-status p { color: var(--members-muted, light-dark(#5c5c5c, #a8adb5)); line-height: 1.6; margin: 0; }
.members-status p + p,
.members-status p + .btn,
.members-status form { margin-top: 1rem; }
.members-status a:not(.btn) { color: var(--members-accent, light-dark(#1a1a1a, #ececec)); font-weight: 600; text-decoration: underline; }
.members-status form.members-grid { display: grid; gap: 1rem; }
.members-status .field label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.3rem; }
.members-status .field input[type="text"],
.members-status .field input[type="email"],
.members-status .field input[type="password"],
.members-status .field textarea {
  width: 100%;
  min-height: 2.75rem;
  border: 1px solid var(--members-line, light-dark(#d0d0d0, #3a3f47));
  border-radius: var(--members-radius, 6px);
  background: var(--members-bg, light-dark(#ffffff, #16181c));
  color: var(--members-ink, light-dark(#1a1a1a, #ececec));
  font: inherit;
  font-size: 1rem;
  padding: 0.55rem 0.75rem;
}
.members-status a:focus-visible,
.members-status button:focus-visible,
.members-status .btn:focus-visible,
.members-status input:focus-visible,
.members-status textarea:focus-visible { outline: 2px solid var(--members-accent, light-dark(#1a1a1a, #ececec)); outline-offset: 2px; }
.members-status .field input:focus-visible { border-color: var(--members-accent, light-dark(#1a1a1a, #ececec)); }
.members-status .field-hint { font-size: 0.8rem; color: var(--members-muted, light-dark(#5c5c5c, #a8adb5)); margin-top: 0.3rem; }
.members-status .members-errors,
.members-status__note { border: 1px solid var(--members-accent, light-dark(#1a1a1a, #ececec)); border-left-width: 4px; border-radius: var(--members-radius, 6px); background: var(--members-bg, light-dark(#ffffff, #16181c)); color: var(--members-ink, light-dark(#1a1a1a, #ececec)); font-size: 0.9rem; padding: 0.7rem 0.9rem; }
.members-status .members-submit { justify-content: center; width: 100%; min-height: 2.75rem; padding: 0.7rem 1rem; }
.members-status form .btn { justify-content: center; }
.members-status .members-submit + .members-switch,
.members-status form + .members-switch { margin-top: 1.2rem; }
.members-status .members-switch { font-size: 0.875rem; text-align: center; }
.members-status__note { margin-bottom: 1rem; }
@media (min-width: 640px) { .members-status { padding: 5rem 1.5rem 6rem; } .members-status__card { padding: 2rem; } }
{% endblock %}
{% endapply %}
{% endblock %}

