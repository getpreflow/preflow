{
    "key": "game",
    "table": "game",
    "storage": "sqlite",
    "id_field": "uuid",
    "label": "Games",
    "publishing": true,
    "frontend": {
        "route": "/play/{slug}",
        "template": "templates/folio/game.twig"
    },
    "list": {
        "columns": [
            "name",
            "complexity"
        ],
        "sort": "name"
    },
    "fields": {
        "name": {
            "type": "string",
            "translatable": true,
            "validate": [
                "required"
            ]
        },
        "slug": {
            "type": "string",
            "unique": true,
            "help": "Lowercase words joined by hyphens, e.g. harvest-moon. The game's address: /play/{slug}.",
            "validate": [
                "required",
                "regex:/^[a-z0-9]+(?:-[a-z0-9]+)*$/"
            ]
        },
        "description": {
            "type": "text",
            "translatable": true
        },
        "designer": {
            "type": "string"
        },
        "publisher": {
            "type": "string"
        },
        "year_published": {
            "type": "number",
            "searchable": false
        },
        "min_players": {
            "type": "number",
            "searchable": false
        },
        "max_players": {
            "type": "number",
            "searchable": false
        },
        "play_time_minutes": {
            "type": "number",
            "searchable": false
        },
        "teach_time_minutes": {
            "type": "number",
            "searchable": false
        },
        "bgg_id": {
            "type": "number",
            "label": "BGG ID",
            "searchable": false
        },
        "complexity": {
            "type": "number",
            "step": 0.01,
            "help": "BGG weight, 0 to 5.",
            "searchable": false
        },
        "tags": {
            "type": "string",
            "translatable": true,
            "help": "Comma-separated."
        },
        "cover": {
            "type": "asset",
            "asset": {
                "accept": "image/*"
            }
        },
        "flow": {
            "type": "flow",
            "label": "Flow",
            "searchable": false,
            "ai": {
                "kinds": {
                    "quiz-option": "Keep answer options short; same length class as the source."
                }
            }
        },
        "created_at": {
            "type": "string",
            "label": "Created",
            "hidden": true,
            "searchable": false,
            "help": "When the game was created in the old admin, UTC ISO 8601 (set by php preflow bggenius:migrate)."
        },
        "seed_hash": {
            "type": "string",
            "hidden": true,
            "searchable": false,
            "help": "Set by php preflow game:seed: the hash of what the seed wrote, to tell Folio edits apart."
        }
    }
}
