{# The Account panel of a staff account (side column): its state, then what those who may change it can do. #}
<p>
    <span class="folio-badge{{ active ? ' is-published' : ' is-draft' }}">{{ active ? t('rbac.account.active') : t('rbac.account.disabled') }}</span>
    {% if invited %}<span class="folio-badge is-changed">{{ t('rbac.account.no_password') }}</span>{% endif %}
</p>
<p class="folio-help">
    {%- if not active -%}
        {{ t('rbac.account.disabled_help') }}
    {%- elseif invited -%}
        {{ t('rbac.account.invited_help') }}
    {%- else -%}
        {{ t('rbac.account.active_help') }}
    {%- endif -%}
</p>
{% if may_act %}
    <div class="folio-form-buttons">
        {% if active and invited %}
            <form method="post" action="{{ prefix }}/{{ type }}/{{ id }}/_action/invite">
                <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-secondary">{{ t('rbac.actions.invite') }}</button>
            </form>
        {% elseif active %}
            <form method="post" action="{{ prefix }}/{{ type }}/{{ id }}/_action/reset">
                <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-secondary">{{ t('rbac.actions.reset') }}</button>
            </form>
        {% endif %}
        {% if active %}
            <form method="post" action="{{ prefix }}/{{ type }}/{{ id }}/_action/disable" data-confirm="{{ t('rbac.account.disable_confirm', {email: record.email}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-ghost">{{ t('rbac.actions.disable') }}</button>
            </form>
        {% else %}
            <form method="post" action="{{ prefix }}/{{ type }}/{{ id }}/_action/enable">
                <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                <button type="submit" class="btn btn-secondary">{{ t('rbac.actions.enable') }}</button>
            </form>
        {% endif %}
    </div>
{% elseif above %}
    <p class="folio-help">{{ above_message }}</p>
{% endif %}
