{
    "name": "preflow/folio",
    "description": "Folio — the admin for Preflow sites: edit and publish models and pages, media library, page rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.82.0 || @dev",
        "preflow/data": "^0.92.0 || @dev",
        "preflow/view": "^0.74 || @dev",
        "preflow/twig": "^0.65 || @dev",
        "preflow/routing": "^0.78.2 || @dev",
        "preflow/form": "^0.75 || @dev",
        "preflow/validation": "^0.52 || @dev",
        "preflow/auth": "^0.83.0 || @dev",
        "preflow/blocks": "^0.92.0 || @dev",
        "preflow/publishing": "^0.81.0 || @dev",
        "preflow/components": "^0.1 || @dev",
        "preflow/htmx": "^0.65 || @dev",
        "preflow/i18n": "^0.83.0 || @dev",
        "preflow/media": "^0.89.0 || @dev",
        "preflow/notify": "^0.69 || @dev",
        "preflow/devtools": "^0.85.0 || @dev",
        "preflow/fields": "^0.91.0 || @dev",
        "nyholm/psr7": "^1.8",
        "symfony/html-sanitizer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/ai": "^0.78 || @dev",
        "preflow/block-library": "^0.92.0 || @dev"
    },
    "suggest": {
        "openspout/openspout": "^4 — Excel export of admin lists (the Export button shows once it is installed)",
        "preflow/ai": "AI features: Translate, \"Write a draft\" and Settings → AI (they appear only when it is installed)",
        "preflow/codes": "Codes; Folio adds their admin (the built-in extension \"codes\")",
        "preflow/members": "Member accounts; Folio adds their admin (the built-in extension \"members\", which needs preflow/rbac)",
        "preflow/rbac": "Stored roles and staff accounts; Folio adds their admin (the built-in extension \"rbac\")"
    },
    "conflict": {
        "preflow/ai": "<0.78",
        "preflow/auth": "<0.83.0",
        "preflow/blocks": "<0.92.0",
        "preflow/codes": "<0.68",
        "preflow/core": "<0.82.0",
        "preflow/data": "<0.92.0",
        "preflow/devtools": "<0.85.0",
        "preflow/fields": "<0.91.0",
        "preflow/form": "<0.75",
        "preflow/htmx": "<0.65",
        "preflow/i18n": "<0.83.0",
        "preflow/media": "<0.89.0",
        "preflow/members": "<0.77",
        "preflow/notify": "<0.69",
        "preflow/publishing": "<0.81.0",
        "preflow/rbac": "<0.84.0",
        "preflow/routing": "<0.78.2",
        "preflow/twig": "<0.65",
        "preflow/validation": "<0.52",
        "preflow/view": "<0.74"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Folio\\": "src/"
        },
        "files": [
            "src/legacy-aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Folio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\Folio\\Console\\ReviewIndexCommand",
                "Preflow\\Folio\\Console\\AssetsVariantsCommand",
                "Preflow\\Folio\\Console\\AssetsImportCommand",
                "Preflow\\Folio\\Console\\ExportCommand",
                "Preflow\\Folio\\Console\\ImportCommand",
                "Preflow\\Folio\\Console\\PullCommand",
                "Preflow\\Folio\\Console\\ExtensionsListCommand",
                "Preflow\\Folio\\Console\\ExtensionsEnableCommand",
                "Preflow\\Folio\\Console\\ExtensionsDisableCommand",
                "Preflow\\Folio\\Console\\ExtensionsApplyCommand",
                "Preflow\\Folio\\Console\\ExtensionsCheckCommand",
                "Preflow\\Folio\\Console\\ExtensionsUninstallCommand",
                "Preflow\\Folio\\Console\\InstallCommand"
            ],
            "runtime": [
                "config/folio/extensions.json"
            ],
            "translations": {
                "folio": {
                    "path": "lang",
                    "scope": "admin"
                },
                "codes": {
                    "path": "lang",
                    "scope": "admin"
                },
                "members-admin": {
                    "path": "lang",
                    "scope": "admin"
                },
                "rbac-admin": {
                    "path": "lang",
                    "scope": "admin"
                }
            }
        }
    }
}
