{
    "name": "preflow/folio",
    "description": "Folio — the admin for Preflow sites: edit and publish models and pages, media library, page rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/ai": "^0.66 || @dev",
        "preflow/core": "^0.75 || @dev",
        "preflow/data": "^0.76 || @dev",
        "preflow/view": "^0.74 || @dev",
        "preflow/twig": "^0.65 || @dev",
        "preflow/routing": "^0.70 || @dev",
        "preflow/form": "^0.75 || @dev",
        "preflow/validation": "^0.52 || @dev",
        "preflow/auth": "^0.69 || @dev",
        "preflow/blocks": "^0.75 || @dev",
        "preflow/publishing": "^0.75 || @dev",
        "preflow/components": "^0.1 || @dev",
        "preflow/htmx": "^0.65 || @dev",
        "preflow/i18n": "^0.76 || @dev",
        "preflow/media": "^0.76 || @dev",
        "preflow/notify": "^0.69 || @dev",
        "preflow/devtools": "^0.20 || @dev",
        "nyholm/psr7": "^1.8",
        "symfony/html-sanitizer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "openspout/openspout": "^4 — Excel export of admin lists (the Export button shows once it is installed)",
        "preflow/codes": "Codes; Folio adds their admin (the built-in extension \"codes\")",
        "preflow/members": "Member accounts; Folio adds their admin (the built-in extension \"members\", which needs preflow/rbac)",
        "preflow/rbac": "Stored roles and staff accounts; Folio adds their admin (the built-in extension \"rbac\")"
    },
    "conflict": {
        "preflow/ai": "<0.66",
        "preflow/auth": "<0.69",
        "preflow/blocks": "<0.75",
        "preflow/codes": "<0.68",
        "preflow/core": "<0.75",
        "preflow/data": "<0.76",
        "preflow/form": "<0.75",
        "preflow/htmx": "<0.65",
        "preflow/i18n": "<0.76",
        "preflow/media": "<0.76",
        "preflow/members": "<0.68",
        "preflow/notify": "<0.69",
        "preflow/publishing": "<0.75",
        "preflow/rbac": "<0.69.1",
        "preflow/routing": "<0.70",
        "preflow/twig": "<0.65",
        "preflow/validation": "<0.52",
        "preflow/view": "<0.74"
    },
    "autoload": {
        "psr-4": { "Preflow\\Folio\\": "src/" },
        "files": ["src/legacy-aliases.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Folio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "runtime": ["config/folio/extensions.json"],
            "translations": {
                "folio": { "path": "lang", "scope": "admin" },
                "codes": { "path": "lang", "scope": "admin" },
                "members-admin": { "path": "lang", "scope": "admin" },
                "rbac-admin": { "path": "lang", "scope": "admin" }
            }
        }
    }
}
