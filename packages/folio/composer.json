{
    "name": "preflow/folio",
    "description": "Folio — drop-in CMS for Preflow: shipped admin, JSON content types, slug rendering",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.34 || @dev",
        "preflow/data": "^0.34 || @dev",
        "preflow/view": "^0.1 || @dev",
        "preflow/routing": "^0.1 || @dev",
        "preflow/form": "^0.1 || @dev",
        "preflow/validation": "^0.1 || @dev",
        "preflow/auth": "^0.27 || @dev",
        "preflow/components": "^0.1 || @dev",
        "preflow/htmx": "^0.1 || @dev",
        "preflow/i18n": "^0.26 || @dev",
        "preflow/media": "^0.34 || @dev",
        "preflow/notify": "^0.25 || @dev",
        "preflow/devtools": "^0.20 || @dev",
        "nyholm/psr7": "^1.8",
        "symfony/html-sanitizer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "openspout/openspout": "^4 — Excel export of admin lists (the Export button shows once it is installed)"
    },
    "conflict": {
        "preflow/auth": "<0.27",
        "preflow/core": "<0.34",
        "preflow/data": "<0.34",
        "preflow/i18n": "<0.26",
        "preflow/media": "<0.34",
        "preflow/notify": "<0.25"
    },
    "autoload": {
        "psr-4": { "Preflow\\Folio\\": "src/" },
        "files": ["src/legacy-aliases.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Folio\\Tests\\": "tests/"
        }
    }
}
