{% extends '@folio/admin/_auth_layout.twig' %}
{% block title %}{{ expired ? 'Link expired' : 'Choose a password' }}{% endblock %}
{% block card %}
        <form class="folio-auth-card folio-auth-card-fixed" method="post" action="{{ password_action }}">
            {{ csrf_field()|raw }}
            <div class="folio-brand folio-auth-brand">{% include '@folio/admin/_logo.twig' %}<span class="folio-brand-name">Folio</span></div>
            {% if expired %}
            <h1 class="folio-auth-title">This link has expired</h1>
            <p class="folio-auth-lead">This link was already used or has expired. Ask for a new one.</p>
            <a class="btn btn-primary" href="{{ forgot_url }}">Send a new link</a>
            {% else %}
            <h1 class="folio-auth-title">Choose a password</h1>
            <p class="folio-auth-lead">Use at least {{ password_min }} characters.</p>
            {% if error %}
                <div class="folio-alert folio-alert-error" role="alert">{{ error }}</div>
            {% endif %}
            <input type="hidden" name="token" value="{{ token }}">
            <div class="form-group">
                <label for="password">New password</label>
                <input type="password" name="password" id="password" autocomplete="new-password" minlength="{{ password_min }}" required autofocus>
            </div>
            <div class="form-group">
                <label for="repeat">Repeat the password</label>
                <input type="password" name="repeat" id="repeat" autocomplete="new-password" minlength="{{ password_min }}" required>
            </div>
            <button type="submit" class="btn btn-primary">Save password and sign in</button>
            {% endif %}
            <p class="folio-auth-back"><a class="folio-auth-link" href="{{ login_url }}">Back to sign in</a></p>
        </form>
{% endblock %}
