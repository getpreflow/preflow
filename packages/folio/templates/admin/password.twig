{% extends '@folio/admin/_auth_layout.twig' %}
{% block title %}{{ expired ? t('folio.auth.link_expired') : t('folio.auth.choose_password') }}{% endblock %}
{% block card %}
        <form class="folio-auth-card folio-auth-card-fixed" method="post" action="{{ password_action }}">
            {{ csrf_field()|raw }}
            <div class="folio-brand folio-auth-brand">{% include '@folio/admin/_logo.twig' %}<span class="folio-brand-name">Folio</span></div>
            {% if expired %}
            <h1 class="folio-auth-title">{{ t('folio.auth.expired_title') }}</h1>
            <p class="folio-auth-lead">{{ t('folio.auth.expired_lead') }}</p>
            <a class="btn btn-primary" href="{{ forgot_url }}">{{ t('folio.auth.send_new_link') }}</a>
            {% else %}
            <h1 class="folio-auth-title">{{ t('folio.auth.choose_password') }}</h1>
            <p class="folio-auth-lead">{{ t('folio.auth.password_min', {min: password_min}) }}</p>
            {% if error %}
                <div class="folio-alert folio-alert-error" role="alert">{{ error }}</div>
            {% endif %}
            <input type="hidden" name="token" value="{{ token }}">
            <div class="form-group">
                <label for="password">{{ t('folio.auth.new_password') }}</label>
                <input type="password" name="password" id="password" autocomplete="new-password" minlength="{{ password_min }}" required autofocus>
            </div>
            <div class="form-group">
                <label for="repeat">{{ t('folio.auth.repeat_password') }}</label>
                <input type="password" name="repeat" id="repeat" autocomplete="new-password" minlength="{{ password_min }}" required>
            </div>
            <button type="submit" class="btn btn-primary">{{ t('folio.auth.save_and_sign_in') }}</button>
            {% endif %}
            <p class="folio-auth-back"><a class="folio-auth-link" href="{{ login_url }}">{{ t('folio.auth.back_to_sign_in') }}</a></p>
        </form>
{% endblock %}
