{% extends "@folio/admin/_layout.twig" %}
{# A redirect entry (RedirectsController): the old address as visitors see it, "and everything under it" with its mode,
   the target (a page from the picker as "type:id", a URL or a path) and, for hand-made entries, 301 or 302. #}
{% block title %}Folio — {{ entry ? t('folio.redirects.edit') : t('folio.redirects.new') }}{% endblock %}
{% block page_title %}{{ entry ? t('folio.redirects.edit') : t('folio.redirects.new') }}{% endblock %}
{% block content %}
    <p><a href="{{ prefix }}/redirects">← {{ t('folio.nav.redirects') }}</a></p>
    <form class="folio-form" method="post" action="{{ action }}" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
        {% if values.not_found %}<input type="hidden" name="not_found" value="{{ values.not_found }}">{% endif %}
        <div class="form-group">
            <label class="form-label" for="folio-redirect-address">{{ t('folio.redirects.address') }}</label>
            <input type="text" id="folio-redirect-address" name="address" value="{{ values.address }}" placeholder="/…" autocomplete="off" required>
            <small class="form-help">{{ t('folio.redirects.address_help') }}</small>
            {% if errors.address is defined %}<div class="form-error">{{ errors.address }}</div>{% endif %}
        </div>
        <fieldset class="form-group">
            <label class="form-check"><input type="checkbox" name="area" value="1"{% if values.area %} checked{% endif %}> {{ t('folio.redirects.area') }}</label>
            <div>
                <label class="form-radio"><input type="radio" name="mode" value="one"{% if values.mode != 'prefix' %} checked{% endif %}> {{ t('folio.redirects.mode_one') }}</label>
                <label class="form-radio"><input type="radio" name="mode" value="prefix"{% if values.mode == 'prefix' %} checked{% endif %}> {{ t('folio.redirects.mode_prefix') }}</label>
            </div>
        </fieldset>
        <div class="form-group">
            <label class="form-label" for="folio-redirect-target">{{ t('folio.redirects.target') }}</label>
            {# admin.js fills the list from _targets as the user types: the value is "type:id", the label the page and its URL. #}
            <input type="text" id="folio-redirect-target" name="target" value="{{ values.target }}" list="folio-redirect-targets" placeholder="{{ t('folio.redirects.target_search') }}" autocomplete="off" data-redirect-targets="{{ prefix }}/redirects/_targets" required>
            <datalist id="folio-redirect-targets"></datalist>
            {% if picked %}<small class="form-help">{{ t('folio.redirects.target_picked', {label: picked}) }}</small>{% endif %}
            <small class="form-help">{{ t('folio.redirects.target_help') }}</small>
            {% if errors.target is defined %}<div class="form-error">{{ errors.target }}</div>{% endif %}
        </div>
        <fieldset class="form-group">
            <legend class="form-label">{{ t('folio.redirects.answer') }}</legend>
            {% if manual %}
                <label class="form-radio"><input type="radio" name="status" value="301"{% if values.status != 302 %} checked{% endif %}> {{ t('folio.redirects.permanent') }}</label>
                <label class="form-radio"><input type="radio" name="status" value="302"{% if values.status == 302 %} checked{% endif %}> {{ t('folio.redirects.temporary') }}</label>
            {% else %}
                <small class="form-help">{{ t('folio.redirects.automatic_status') }}</small>
            {% endif %}
        </fieldset>
        <div class="folio-form-buttons">
            <a class="btn btn-ghost" href="{{ prefix }}/redirects">{{ t('folio.common.cancel') }}</a>
            <button type="submit" class="btn btn-primary" data-busy-label="{{ t('folio.form.saving') }}">{{ t('folio.common.save') }}</button>
        </div>
    </form>
{% endblock %}
