<div class="folio-block-card is-unknown" id="block-{{ uid }}" data-block-card data-block-uid="{{ uid }}">
    <input type="hidden" name="{{ name }}[_order][]" value="{{ uid }}">
    <input type="hidden" name="{{ name }}[{{ uid }}][_block]" value="{{ key }}">
    <input type="hidden" name="{{ name }}[{{ uid }}][_raw]" value="{{ raw }}">
    <div class="folio-block-head">
        <span class="folio-block-label">Unknown block “{{ key }}”</span>
        <span class="folio-block-summary">Its block class no longer exists; the content is kept until you remove it.</span>
        <div class="folio-block-actions">
            <button type="button" class="btn btn-ghost" data-block-remove aria-label="Remove">✕</button>
        </div>
    </div>
</div>
