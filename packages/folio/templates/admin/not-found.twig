{% extends layout|default('@folio/admin/_layout.twig') %}
{# The admin's 404 for a page the browser opened (NotFound::response): the message the controller
   gave, the path asked for and, with redirects.manage, a link that starts a redirect from it. #}
{% block title %}Folio — {{ t('folio.errors.not_found_title') }}{% endblock %}
{% block page_title %}{{ t('folio.errors.not_found') }}{% endblock %}
{% block content %}
    {% include '@folio/admin/partials/_ink_error.twig' with {
        title: t('folio.errors.not_found_title'),
        message: message,
        line: path,
        line_link: redirect_url ? {label: t('folio.errors.add_redirect'), url: redirect_url} : null,
    } only %}
{% endblock %}
