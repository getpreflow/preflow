{# The swappable part of a list: chips, bulk bar, table and pager. Rendered alone for ?_partial=1 (admin.js).
   row.cells: plain text (escape it); row.marked: the same text as escaped HTML with search matches in <mark>.
   bulk (null: no tick column, no bar): the bar's actions for this user; the rows' tick boxes belong to its
   form (form="folio-bulk"), so a swap of this region starts a fresh selection. #}
{% set may = {create: can(type ~ '.create'), edit: can(type ~ '.edit'), delete: can(type ~ '.delete')} %}
{% set icons = folio_asset('icons.svg') %}
{% if list.chips is not empty %}
    <div class="folio-filter-chips">
        {% for chip in list.chips %}
            <span class="folio-filter-chip">
                <span>{{ chip.label }}</span>
                <a href="{{ chip.remove }}" aria-label="{{ t('folio.list.remove_filter_named', {name: chip.name}) }}" title="{{ t('folio.list.remove_filter') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-x"></use></svg></a>
            </span>
        {% endfor %}
    </div>
{% endif %}
{% if not has_records %}
    <div class="folio-empty">
        <svg class="folio-icon folio-empty-icon" aria-hidden="true"><use href="{{ icons }}#ui-file"></use></svg>
        <p>{{ t('folio.list.empty', {label: folio_noun(label)}) }}</p>
        {% if may.create %}<a class="btn btn-primary" href="{{ prefix }}/{{ type }}/new">{{ t('folio.list.create_one') }}</a>{% endif %}
    </div>
{% elseif rows is empty %}
    <div class="folio-empty folio-no-matches">
        <svg class="folio-icon folio-empty-icon" aria-hidden="true"><use href="{{ icons }}#ui-search"></use></svg>
        <p>{{ t('folio.list.no_matches') }}</p>
        <a href="{{ list.clear }}">{{ t('folio.list.clear_search') }}</a>
    </div>
{% else %}
    {% set first_column = columns|keys|first %}
    {# The frame holds the bar and the table: with JS the bar lies over the header row (is-overlay),
       so showing or hiding it never moves the rows; the header's select-all stays on top of it. #}
    <div class="folio-table-frame">
    {% if bulk|default(null) %}
        {# Each button posts the ticked ids[] to its own formaction. Without JS the bar stays visible above the table. #}
        <form class="folio-bulk-bar" id="folio-bulk" method="post" data-folio-bulk>
            <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
            <input type="hidden" name="_query" value="{{ list_query|default('') }}">
            <span class="folio-bulk-count" data-folio-bulk-count>{{ t('folio.list.with_selected') }}</span>
            {% for field in bulk.fields %}
                <details class="folio-bulk-menu">
                    <summary class="btn btn-sm">{{ t('folio.list.set_field', {label: field.label}) }} ▾</summary>
                    <div class="folio-bulk-options">
                        {% for value, text in field.options %}<button type="submit" class="btn btn-sm" formaction="{{ field.url }}" name="value" value="{{ value }}">{{ text }}</button>{% endfor %}
                    </div>
                </details>
            {% endfor %}
            {% for action in bulk.actions %}<button type="submit" class="btn btn-sm" formaction="{{ action.url }}"{% if action.confirm %} data-confirm="{{ action.confirm }}"{% endif %}>{{ action.label }}</button>{% endfor %}
            {# Needs JS: it sends the ticked ids to the export URL (a GET download), so the CSRF token never goes into a URL. #}
            {% if export_url|default(null) %}<button type="button" class="btn btn-sm" data-folio-export="{{ export_url }}{{ list_query ? '?' ~ list_query }}" hidden>{{ t('folio.common.export') }}</button>{% endif %}
            {% if bulk.delete %}<button type="submit" class="btn btn-sm" data-tone="danger" formaction="{{ bulk.delete.url }}" data-delete-plan="{{ bulk.delete.plan }}" data-confirm="{{ t('folio.list.confirm_bulk_delete') }}">{{ t('folio.common.delete') }}</button>{% endif %}
            <button type="reset" class="btn btn-sm folio-bulk-clear" data-folio-bulk-clear>{{ t('folio.common.clear') }}</button>
        </form>
    {% endif %}
    <div class="folio-table-wrap">
    <table class="folio-table">
        <thead><tr>
            {%- if bulk|default(null) %}<th class="folio-bulk-cell"><input type="checkbox" data-folio-bulk-all aria-label="{{ t('folio.list.select_all') }}" hidden></th>{% endif -%}
            {%- for name, header in list.headers -%}
                <th{% if header.dir %} aria-sort="{{ header.dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
                    {%- if header.href %}<a class="folio-sort" href="{{ header.href }}">{{ header.label }} {% if header.dir %}<span class="folio-sort-mark" aria-hidden="true">{{ header.dir == 'asc' ? '▲' : '▼' }}</span>{% else %}<span class="folio-sort-mark is-idle" aria-hidden="true"></span>{% endif %}</a>{% else %}{{ header.label }}{% endif -%}
                </th>
            {%- endfor -%}
            {%- for heading in extra_columns|default([]) %}<th>{{ heading }}</th>{% endfor %}{% if multilingual|default(false) %}<th>{{ t('folio.common.languages') }}</th>{% endif %}{% if publishing|default(false) %}<th>{{ t('folio.list.publishing') }}</th>{% endif %}<th><span class="folio-sr">{{ t('folio.common.actions') }}</span></th></tr></thead>
        <tbody>
        {% for row in rows %}
            {% set up_disabled = loop.first and list.page == 1 %}
            {% set down_disabled = loop.last and list.page == list.last_page %}
            <tr>
                {% if bulk|default(null) %}<td class="folio-bulk-cell"><input type="checkbox" name="ids[]" value="{{ row.id }}" form="folio-bulk" data-folio-bulk-item aria-label="{{ t('folio.list.select_row', {label: row.cells[first_column]|default('') ?: t('folio.common.untitled')}) }}"></td>{% endif %}
                {% for name, heading in columns %}<td>{% if loop.first %}<a class="folio-row-link" href="{{ prefix }}/{{ type }}/{{ row.id }}/edit">{% if row.marked[name] != '' %}{{ row.marked[name]|raw }}{% else %}{{ t('folio.common.untitled') }}{% endif %}</a>{% else %}{{ row.marked[name]|raw }}{% endif %}</td>{% endfor %}{% for cell in row.extra|default([]) %}<td>{% if cell is iterable %}<span class="folio-badge{% if cell.tone %} is-{{ cell.tone }}{% endif %}">{{ cell.label }}</span>{% else %}{{ cell }}{% endif %}</td>{% endfor %}
                {% if multilingual|default(false) %}<td>{% for badge in row.languages %}<span class="folio-badge{% if 'missing' in badge %} is-incomplete{% endif %}">{{ badge }}</span> {% endfor %}</td>{% endif %}
                {% if publishing|default(false) %}<td><span class="folio-badge is-{{ row.state.value }}">{{ row.state.label() }}</span></td>{% endif %}
                <td>
                    <div class="folio-row-actions">
                        {% if orderable and may.edit %}
                            {% for direction, text in {'up': t('folio.common.move_up'), 'down': t('folio.common.move_down')} %}
                                <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/move">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                    <input type="hidden" name="direction" value="{{ direction }}">
                                    {% if list.page > 1 %}<input type="hidden" name="page" value="{{ list.page }}">{% endif %}
                                    <button type="submit" class="btn btn-ghost btn-icon" aria-label="{{ text }}" title="{{ text }}"{% if (direction == 'up' and up_disabled) or (direction == 'down' and down_disabled) %} disabled{% endif %}><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-{{ direction }}"></use></svg></button>
                                </form>
                            {% endfor %}
                        {% endif %}
                        {% if may.edit %}<a class="btn btn-secondary btn-sm" href="{{ prefix }}/{{ type }}/{{ row.id }}/edit">{{ t('folio.common.edit') }}</a>{% endif %}
                        {% if may.delete %}
                        <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/delete" data-confirm="{{ t('folio.list.confirm_delete') }}" data-delete-plan="{{ prefix }}/{{ type }}/_delete-plan" data-delete-id="{{ row.id }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                            <button type="submit" class="btn btn-ghost btn-icon" data-tone="danger" aria-label="{{ t('folio.common.delete') }}" title="{{ t('folio.common.delete') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-trash"></use></svg></button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    </div>
    <nav class="folio-pager" aria-label="{{ t('folio.list.pages') }}">
        <span class="folio-pager-count">{{ t('folio.list.pager', {start: folio_number(list.from), end: folio_number(list.to), total: folio_number(list.total)}) }}</span>
        {% if list.last_page > 1 %}
            <span class="folio-pager-links">
                {% if list.prev %}<a class="btn btn-ghost btn-sm" href="{{ list.prev }}" rel="prev" aria-label="{{ t('folio.list.previous_page') }}">‹</a>{% endif %}
                {% for p in list.pages %}
                    {% if p.n is null %}<span class="folio-pager-gap">…</span>
                    {% elseif p.current %}<span class="btn btn-ghost btn-sm is-active" aria-current="page">{{ p.n }}</span>
                    {% else %}<a class="btn btn-ghost btn-sm" href="{{ p.href }}">{{ p.n }}</a>{% endif %}
                {% endfor %}
                {% if list.next %}<a class="btn btn-ghost btn-sm" href="{{ list.next }}" rel="next" aria-label="{{ t('folio.list.next_page') }}">›</a>{% endif %}
            </span>
        {% endif %}
    </nav>
{% endif %}
