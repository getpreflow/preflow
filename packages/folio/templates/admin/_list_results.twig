{# The swappable part of a list: chips, table, bulk bar and pager. Rendered alone for ?_partial=1 (admin.js).
   row.cells: plain text (escape it); row.marked: the same text as escaped HTML with search matches in <mark>.
   bulk (null: no tick column, no bar): the bar's actions for this user; the rows' tick boxes belong to its
   form (form="folio-bulk"), so a swap of this region starts a fresh selection.
   Each row ends in one "…" menu (<details class="folio-row-menu">): the row's link opens the record, the
   menu holds everything else. Without JS it opens in place; admin.js adds the keyboard (menu pattern). #}
{% import '@folio/admin/partials/_type_icon.twig' as types %}
{% import '@folio/admin/partials/_languages.twig' as langs %}
{% set may = may|default({create: can(type ~ '.create'), edit: can(type ~ '.edit'), delete: can(type ~ '.delete')}) %}
{% set icons = folio_asset('icons.svg') %}
{% if list.chips is not empty %}
    <div class="folio-filter-chips">
        {% for chip in list.chips %}
            <span class="folio-filter-chip">
                <span>{{ chip.label }}</span>
                <a href="{{ chip.remove }}" aria-label="{{ t('folio.list.remove_filter_named', {name: chip.name}) }}" title="{{ t('folio.list.remove_filter') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-x"></use></svg></a>
            </span>
        {% endfor %}
    </div>
{% endif %}
{% if not has_records %}
    <div class="folio-empty">
        <svg class="folio-icon folio-empty-icon" aria-hidden="true"><use href="{{ icons }}#ui-file"></use></svg>
        <p>{{ empty_text|default(t('folio.list.empty', {label: folio_noun(label)})) }}</p>
        {% if may.create %}<a class="btn btn-primary" href="{{ prefix }}/{{ type }}/new">{{ t('folio.list.create_one') }}</a>{% endif %}
    </div>
{% elseif rows is empty %}
    <div class="folio-empty folio-no-matches">
        <svg class="folio-icon folio-empty-icon" aria-hidden="true"><use href="{{ icons }}#ui-search"></use></svg>
        <p>{{ t('folio.list.no_matches') }}</p>
        <a href="{{ list.clear }}">{{ t('folio.list.clear_search') }}</a>
    </div>
{% else %}
    {% set first_column = columns|keys|first %}
    {% set kinds = column_kinds|default({}) %}
    {% set row_menu = row_menu|default({duplicate: false, actions: []}) %}
    {# The frame holds the table and the bulk bar, which floats under the table while rows are ticked. #}
    <div class="folio-table-frame">
    <div class="folio-table-wrap">
    <table class="folio-table folio-list-table" data-folio-list-table>
        <thead><tr>
            {%- if bulk|default(null) %}<th class="folio-bulk-cell"><input type="checkbox" data-folio-bulk-all aria-label="{{ t('folio.list.select_all') }}" hidden></th>{% endif -%}
            {%- for name, header in list.headers -%}
                <th{% if kinds[name]|default('') == 'number' %} class="is-number"{% endif %}{% if header.dir %} aria-sort="{{ header.dir == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
                    {%- if header.href %}<a class="folio-sort" href="{{ header.href }}">{{ header.label }} {% if header.dir %}<span class="folio-sort-mark" aria-hidden="true">{{ header.dir == 'asc' ? '↑' : '↓' }}</span>{% else %}<span class="folio-sort-mark is-idle" aria-hidden="true"></span>{% endif %}</a>{% else %}{{ header.label }}{% endif -%}
                </th>
                {%- if loop.first and frontend|default(false) %}<th>{{ t('folio.list.address') }}</th>{% endif -%}
            {%- endfor -%}
            {%- for heading in extra_columns|default([]) %}<th>{{ heading }}</th>{% endfor %}{% if publishing|default(false) %}<th>{{ t('folio.common.status') }}</th>{% endif %}{% if multilingual|default(false) %}<th>{{ t('folio.common.languages') }}</th>{% endif %}<th class="folio-actions-cell"><span class="folio-sr">{{ t('folio.common.actions') }}</span></th></tr></thead>
        <tbody>
        {% for row in rows %}
            {% set up_disabled = loop.first and list.page == 1 %}
            {% set down_disabled = loop.last and list.page == list.last_page %}
            {% set title = row.cells[first_column]|default('') ?: t('folio.common.untitled') %}
            {% set edit_url = prefix ~ '/' ~ type ~ '/' ~ row.id ~ '/edit' %}
            <tr data-folio-row>
                {% if bulk|default(null) %}<td class="folio-bulk-cell"><input type="checkbox" name="ids[]" value="{{ row.id }}" form="folio-bulk" data-folio-bulk-item aria-label="{{ t('folio.list.select_row', {label: title}) }}"></td>{% endif %}
                {% for name, heading in columns %}
                    {%- if loop.first -%}
                        <td class="folio-cell-title"><div class="folio-row-title">
                            {%- if frontend|default(false) %}{{ row.home ? types.type_icon(family|default(null), 'ui-home') : types.type_icon(family|default(null), glyph|default('ui-file')) }}{% endif -%}
                            <span class="folio-row-text"><a class="folio-row-link" href="{{ edit_url }}">{% if row.marked[name] != '' %}{{ row.marked[name]|raw }}{% else %}{{ t('folio.common.untitled') }}{% endif %}</a>
                            {%- if row.home %}<span class="folio-row-meta">{{ row.home }}</span>{% endif %}</span>
                        </div></td>
                        {%- if frontend|default(false) %}<td class="folio-cell-address folio-mono">{{ row.address|default('') }}</td>{% endif -%}
                    {%- else -%}
                        <td{% if kinds[name]|default('') == 'number' %} class="is-number"{% endif %}>{{ row.marked[name]|raw }}</td>
                    {%- endif -%}
                {% endfor %}
                {%- for cell in row.extra|default([]) %}<td>{% if cell is iterable and cell.href|default(null) %}<a href="{{ cell.href }}">{{ cell.label }}</a>{% elseif cell is iterable %}<span class="folio-badge{% if cell.tone %} is-{{ cell.tone }}{% endif %}">{{ cell.label }}</span>{% else %}{{ cell }}{% endif %}</td>{% endfor %}
                {% if publishing|default(false) %}<td><span class="folio-badge is-{{ row.state.value }}">{{ t('folio.publishing.' ~ row.state.value) }}</span></td>{% endif %}
                {% if multilingual|default(false) %}<td>{{ langs.languages(row.languages, row.unchecked_url|default(null)) }}</td>{% endif %}
                <td class="folio-actions-cell">
                    {%- set menu = row.menu|default({}) %}
                    {#- As on the board: the record's own actions, then a divider and the danger items (Unpublish, Delete…). #}
                    {%- set first_group = may.edit or menu.view_url|default(null) or menu.share_url|default(null) or row_menu.duplicate or (orderable and may.edit) or row_menu.actions is not empty %}
                    {%- set danger = menu.unpublish_url|default(null) or may.delete %}
                    {% if first_group or danger %}
                    <div class="folio-row-actions">
                        <details class="folio-row-menu" data-folio-row-menu>
                            <summary class="btn btn-ghost btn-icon btn-sm" aria-label="{{ t('folio.list.more_actions', {title: title}) }}" title="{{ t('folio.list.more_actions', {title: title}) }}" aria-haspopup="menu"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-dots"></use></svg></summary>
                            <div class="folio-menu folio-row-menu-panel" role="menu" aria-label="{{ t('folio.list.more_actions', {title: title}) }}">
                                {% if may.edit %}<a class="folio-menu-item" role="menuitem" href="{{ edit_url }}" aria-keyshortcuts="E" data-folio-menu-edit><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-edit"></use></svg><span>{{ t('folio.common.edit') }}</span><kbd class="folio-menu-hint" aria-hidden="true">E</kbd></a>{% endif %}
                                {% if menu.view_url|default(null) %}<a class="folio-menu-item" role="menuitem" href="{{ menu.view_url }}" target="_blank" rel="noopener"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-external"></use></svg><span>{{ t('folio.list.view_on_site') }}</span></a>{% endif %}
                                {# Needs JS: the link is made by a POST and written to the clipboard (no link without it). #}
                                {% if menu.share_url|default(null) %}<button type="button" class="folio-menu-item" role="menuitem" data-folio-copy-link="{{ menu.share_url }}" hidden><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#link"></use></svg><span>{{ t('folio.form.copy_preview_link') }}</span></button>{% endif %}
                                {% if row_menu.duplicate %}
                                    <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/duplicate">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                        <button type="submit" class="folio-menu-item" role="menuitem" aria-keyshortcuts="D" data-folio-menu-duplicate><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-copy"></use></svg><span>{{ t('folio.common.duplicate') }}</span><kbd class="folio-menu-hint" aria-hidden="true">D</kbd></button>
                                    </form>
                                {% endif %}
                                {% if orderable and may.edit %}
                                    {% for direction, text in {'up': t('folio.common.move_up'), 'down': t('folio.common.move_down')} %}
                                        <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/move">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                            <input type="hidden" name="direction" value="{{ direction }}">
                                            {% if list.page > 1 %}<input type="hidden" name="page" value="{{ list.page }}">{% endif %}
                                            <button type="submit" class="folio-menu-item" role="menuitem"{% if (direction == 'up' and up_disabled) or (direction == 'down' and down_disabled) %} disabled{% endif %}><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-{{ direction }}"></use></svg><span>{{ text }}</span></button>
                                        </form>
                                    {% endfor %}
                                {% endif %}
                                {% for action in row_menu.actions %}
                                    <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id|url_encode }}/_action/{{ action.name }}"{% if action.confirm %} data-confirm="{{ action.confirm }}"{% endif %}>
                                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                        <button type="submit" class="folio-menu-item" role="menuitem">{% if action.icon %}<svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#{{ action.icon }}"></use></svg>{% endif %}<span>{{ action.label }}</span></button>
                                    </form>
                                {% endfor %}
                                {% if first_group and danger %}<div class="folio-menu-sep" role="separator"></div>{% endif %}
                                {% if menu.unpublish_url|default(null) %}
                                    <form method="post" action="{{ menu.unpublish_url }}" data-confirm="{{ t('folio.publishing.confirm_unpublish') }}" data-removal-addresses="{{ menu.unpublish_addresses|default(0) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                        <input type="hidden" name="_from" value="list">
                                        <input type="hidden" name="_query" value="{{ list_query|default('') }}">
                                        <button type="submit" class="folio-menu-item is-danger" role="menuitem"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-unpublish"></use></svg><span>{{ t('folio.publishing.unpublish') }}</span></button>
                                    </form>
                                {% endif %}
                                {% if may.delete %}
                                    <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/delete" data-confirm="{{ t('folio.list.confirm_delete') }}" data-delete-plan="{{ prefix }}/{{ type }}/_delete-plan" data-delete-id="{{ row.id }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                        <button type="submit" class="folio-menu-item is-danger" role="menuitem"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-trash"></use></svg><span>{{ t('folio.common.delete') }}…</span></button>
                                    </form>
                                {% endif %}
                            </div>
                        </details>
                    </div>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% if bulk|default(null) %}
        {# Each button posts the ticked ids[] to its own formaction. Without JS the bar stays visible under the table;
           with JS it shows while rows are ticked, floating at the bottom of the window (is-floating). #}
        <form class="folio-bulk-bar" id="folio-bulk" method="post" role="toolbar" aria-label="{{ t('folio.list.selection') }}" data-folio-bulk>
            <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
            <input type="hidden" name="_query" value="{{ list_query|default('') }}">
            <span class="folio-bulk-count" data-folio-bulk-count>{{ t('folio.list.with_selected') }}</span>
            {% for field in bulk.fields %}
                <details class="folio-bulk-menu">
                    <summary class="btn btn-sm">{{ t('folio.list.set_field', {label: field.label}) }}<svg class="folio-icon folio-bulk-caret" aria-hidden="true"><use href="{{ icons }}#ui-chevron"></use></svg></summary>
                    <div class="folio-bulk-options folio-menu">
                        {% for value, text in field.options %}<button type="submit" class="folio-menu-item" formaction="{{ field.url }}" name="value" value="{{ value }}">{{ text }}</button>{% endfor %}
                    </div>
                </details>
            {% endfor %}
            {% for action in bulk.actions %}<button type="submit" class="btn btn-sm" formaction="{{ action.url }}"{% if action.confirm %} data-confirm="{{ action.confirm }}"{% endif %}>{{ action.label }}</button>{% endfor %}
            {# The AI run screen for the ticked rows: a POST of ids[] shows its form (the token stays out of the URL). #}
            {% if bulk.translate|default(null) %}<button type="submit" class="btn btn-sm" formaction="{{ bulk.translate }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-spark"></use></svg>{{ t('folio.ai_run.translate_selected') }}</button>{% endif %}
            {# Needs JS: it sends the ticked ids to the export URL (a GET download), so the CSRF token never goes into a URL. #}
            {% if export_url|default(null) %}<button type="button" class="btn btn-sm" data-folio-export="{{ export_url }}{{ list_query ? '?' ~ list_query }}" hidden><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-download"></use></svg>{{ t('folio.common.export') }}</button>{% endif %}
            {% if bulk.delete %}<button type="submit" class="btn btn-sm" data-tone="danger" formaction="{{ bulk.delete.url }}" data-delete-plan="{{ bulk.delete.plan }}" data-confirm="{{ t('folio.list.confirm_bulk_delete') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-trash"></use></svg>{{ t('folio.common.delete') }}</button>{% endif %}
            <button type="reset" class="btn btn-sm btn-icon folio-bulk-clear" data-folio-bulk-clear aria-label="{{ t('folio.common.clear') }}" title="{{ t('folio.common.clear') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-x"></use></svg></button>
        </form>
    {% endif %}
    </div>
    <nav class="folio-pager" aria-label="{{ t('folio.list.pages') }}">
        <span class="folio-pager-count">{{ t('folio.list.pager', {start: folio_number(list.from), end: folio_number(list.to), total: folio_number(list.total)}) }}</span>
        {% if list.last_page > 1 %}
            <span class="folio-pager-links">
                {% if list.prev %}<a class="btn btn-ghost btn-icon btn-sm" href="{{ list.prev }}" rel="prev" aria-label="{{ t('folio.list.previous_page') }}" title="{{ t('folio.list.previous_page') }}"><svg class="folio-icon is-mirrored" aria-hidden="true"><use href="{{ icons }}#ui-chevron"></use></svg></a>{% endif %}
                {% for p in list.pages %}
                    {% if p.n is null %}<span class="folio-pager-gap">…</span>
                    {% elseif p.current %}<span class="btn btn-ghost btn-sm is-active" aria-current="page">{{ p.n }}</span>
                    {% else %}<a class="btn btn-ghost btn-sm" href="{{ p.href }}">{{ p.n }}</a>{% endif %}
                {% endfor %}
                {% if list.next %}<a class="btn btn-ghost btn-icon btn-sm" href="{{ list.next }}" rel="next" aria-label="{{ t('folio.list.next_page') }}" title="{{ t('folio.list.next_page') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-chevron"></use></svg></a>{% endif %}
            </span>
        {% endif %}
    </nav>
{% endif %}
