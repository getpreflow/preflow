{% extends '@folio/admin/_layout.twig' %}
{% block title %}Folio — {{ t('folio.account.title') }}{% endblock %}
{% block page_title %}{{ t('folio.account.title') }}{% endblock %}
{% block content %}
    <div class="folio-account">
        <section class="folio-panel folio-account-who">
            <span class="folio-avatar folio-account-avatar" aria-hidden="true">{{ (name ?: email)|first|upper }}</span>
            <div>
                {% if name %}<p class="folio-account-name">{{ name }}</p>{% endif %}
                <p class="folio-help">{{ email }}</p>
            </div>
        </section>
        {% set interface_locales = folio_interface_locales() %}
        {% if interface_locales|length > 1 %}
        <section class="folio-panel">
            <h2 class="folio-panel-title">{{ t('folio.layout.language') }}</h2>
            <form class="folio-panel-body" method="post" action="{{ locale_action }}">
                {{ csrf_field()|raw }}
                <p class="folio-help">{{ t('folio.account.language_help') }}</p>
                <div class="form-group">
                    <label for="locale" class="folio-sr">{{ t('folio.layout.language') }}</label>
                    <select name="locale" id="locale">
                        {% for code, name in interface_locales %}<option value="{{ code }}"{{ code == interface_locale ? ' selected' : '' }}>{{ name }}</option>{% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('folio.common.save') }}</button>
            </form>
        </section>
        {% endif %}
        <section class="folio-panel">
            <h2 class="folio-panel-title">{{ t('folio.account.change_password') }}</h2>
            <form class="folio-panel-body" method="post" action="{{ password_action }}">
                {{ csrf_field()|raw }}
                <p class="folio-help">{{ t('folio.account.password_help', {min: password_min}) }}</p>
                {% if error %}<div class="folio-alert folio-alert-error" role="alert">{{ error }}</div>{% endif %}
                <input type="email" name="username" value="{{ email }}" autocomplete="username" hidden>
                <div class="form-group">
                    <label for="current">{{ t('folio.account.current_password') }}</label>
                    <input type="password" name="current" id="current" autocomplete="current-password" required>
                </div>
                <div class="form-group">
                    <label for="password">{{ t('folio.auth.new_password') }}</label>
                    <input type="password" name="password" id="password" autocomplete="new-password" minlength="{{ password_min }}" required>
                </div>
                <div class="form-group">
                    <label for="repeat">{{ t('folio.account.repeat_new_password') }}</label>
                    <input type="password" name="repeat" id="repeat" autocomplete="new-password" minlength="{{ password_min }}" required>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('folio.account.change_password') }}</button>
            </form>
        </section>
    </div>
{% endblock %}
