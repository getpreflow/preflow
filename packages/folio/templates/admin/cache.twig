{% extends "@folio/admin/_layout.twig" %}
{% block title %}Folio — {{ t('folio.nav.cache') }}{% endblock %}
{% block page_title %}{{ t('folio.nav.cache') }}{% endblock %}
{% block content %}
    <div class="folio-notice" role="status"><p>{{ t('folio.cache.intro') }}</p></div>
    <div class="folio-list-toolbar">
        <form method="post" action="{{ prefix }}/cache/clear">
            <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
            <input type="hidden" name="all" value="1">
            <button type="submit" class="btn btn-secondary btn-sm">{{ t('folio.cache.clear_all') }}</button>
        </form>
    </div>
    <div class="folio-table-wrap">
    <table class="folio-table">
        <thead><tr><th>{{ t('folio.cache.cache') }}</th><th>{{ t('folio.cache.files') }}</th><th>{{ t('folio.cache.size') }}</th><th><span class="folio-sr">{{ t('folio.common.actions') }}</span></th></tr></thead>
        <tbody>
        {% for cache in caches %}
            <tr>
                <td><strong>{{ cache.label }}</strong> <code>{{ cache.key }}</code>{% if cache.note %}<br>{{ cache.note }}{% endif %}</td>
                <td>{{ folio_number(cache.entries) }}</td>
                <td>{{ cache.size }}</td>
                <td><div class="folio-row-actions">
                    <form method="post" action="{{ prefix }}/cache/clear">
                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                        <input type="hidden" name="key" value="{{ cache.key }}">
                        <button type="submit" class="btn btn-ghost btn-sm" aria-label="{{ t('folio.cache.clear_named', {label: cache.label}) }}">{{ t('folio.cache.clear') }}</button>
                    </form>
                </div></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <section class="folio-cache-opcache">
        <div class="folio-list-toolbar">
            <h2>{{ t('folio.cache.opcache') }}</h2>
            {% if opcache %}
            <form method="post" action="{{ prefix }}/cache/opcache-reset">
                <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                <button type="submit" class="btn btn-secondary btn-sm">{{ t('folio.cache.reset_opcache') }}</button>
            </form>
            {% endif %}
        </div>
        {% if opcache %}
            <div class="folio-table-wrap">
            <table class="folio-table">
                <thead><tr><th>{{ t('folio.cache.memory_used') }}</th><th>{{ t('folio.cache.memory_free') }}</th><th>{{ t('folio.cache.scripts') }}</th><th>{{ t('folio.cache.hit_rate') }}</th></tr></thead>
                <tbody><tr><td>{{ opcache.memory_used }}</td><td>{{ opcache.memory_free }}</td><td>{{ folio_number(opcache.scripts) }}</td><td>{{ folio_number(opcache.hit_rate) }}%</td></tr></tbody>
            </table>
            </div>
        {% else %}
            <div class="folio-notice" role="status"><p>{{ t('folio.cache.opcache_off_web') }}</p></div>
        {% endif %}
    </section>
{% endblock %}
