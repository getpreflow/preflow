{% extends layout|default('@folio/admin/_layout.twig') %}
{# Editors use the icon rail: the form, preview and side panel get the room. #}
{% set shell = 'rail' %}
{% import '@folio/admin/partials/_languages.twig' as langs %}
{% set framed = framed|default(false) %}
{% set record_form = record_form|default('folio-record') %}
{% block title %}Folio — {{ record_title|default(null) ?: heading }}{% endblock %}
{# The editor frame's topbar (0.75): back button · breadcrumb "Label · count" over the title and its
   status badges · content-language switch · layout switch · save state · Save draft · Publish. The
   buttons sit outside the record form and name it (form="folio-record"); see _publish_button.twig. #}
{% block topbar_lead %}{% if back_url|default(null) %}<a class="btn btn-secondary btn-icon folio-back" href="{{ back_url }}" aria-label="{{ t('folio.form.back_to', {label: label}) }}" title="{{ t('folio.form.back_to', {label: label}) }}"><svg class="folio-icon is-mirrored" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-chevron"></use></svg></a>{% endif %}{% endblock %}
{% block breadcrumb %}<nav class="folio-breadcrumb" aria-label="{{ t('folio.form.breadcrumb') }}">{% if back_url|default(null) %}<a href="{{ back_url }}">{{ label }}</a>{% else %}<span>{{ label }}</span>{% endif %}{% if type_count|default(null) is not null %}<span class="folio-breadcrumb-count" title="{{ t('folio.list.count', {count: folio_number(type_count)}, type_count) }}">· {{ folio_number(type_count) }}</span>{% endif %}</nav>{% endblock %}
{% block page_title %}<span class="folio-title-text">{{ record_title|default(null) ?: heading }}</span>{% if publishing %}{% for badge in publishing.badges|default([]) %} <span class="folio-badge is-{{ badge.tone }}">{{ badge.label }}</span>{% endfor %}{% endif %}{% endblock %}
{% block actions %}
    {%- if framed and multilingual|default(false) %}
    {# The content language: a dot per language (filled complete, warning ring partial, subtle ring missing). #}
    <nav class="folio-segmented folio-content-languages" aria-label="{{ t('folio.form.editing_language') }}">
        {%- for lang in languages %}{% set words = langs.words(lang) %}<a class="is-{{ lang.state.completeness.value }}{% if lang.state.stale %} is-stale{% endif %}" href="{{ lang.url }}"{% if lang.active %} aria-current="true"{% endif %} title="{{ words }}"><span class="folio-locale-dot" aria-hidden="true"></span><span aria-hidden="true">{{ lang.code|upper }}</span><span class="folio-sr">{{ words }}</span></a>{% endfor -%}
    </nav>
    {%- endif %}
    {%- if previewable|default(false) %}
    <div class="folio-segmented folio-view-switch" role="group" aria-label="{{ t('folio.form.view') }}" data-folio-preview>{% for mode, text in {'form': t('folio.form.view_form'), 'split': t('folio.form.view_split'), 'preview': t('folio.form.view_preview')} %}<button type="button" data-folio-view="{{ mode }}" aria-pressed="false" title="{{ text }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#{{ {'form': 'ui-form', 'split': 'ui-split', 'preview': 'ui-eye'}[mode] }}"></use></svg><span>{{ text }}</span></button>{% endfor %}</div>
    {%- endif %}
    {%- if publishing and publishing.save_state %}{% include '@folio/admin/publishing/status.twig' with {text: publishing.save_state, version: null, conflict: false} %}{% endif %}
    {%- if framed %}
    {# Phone width: the side panel is a sheet behind this button (admin.js shows the button). #}
    <button type="button" class="btn btn-secondary btn-icon folio-side-toggle" data-folio-side-toggle aria-controls="folio-side" aria-expanded="false" aria-label="{{ t('folio.form.open_side') }}" title="{{ t('folio.form.open_side') }}" hidden><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-panel"></use></svg></button>
    {% include '@folio/admin/partials/_publish_button.twig' %}
    {%- endif %}
{% endblock %}
{% block content %}
    {% set extras = panels|default([])|filter(p => p.position != 'side') %}
    {% set rows = field_rows|default(fields|map(f => {half: false, fields: [f]})) %}
    <div class="folio-editor-frame{% if framed %} has-side{% endif %}" data-folio-editor>
    <div class="folio-editor-main">
    {% if previewable|default(false) %}<div class="folio-split" data-folio-split data-mode="form">
    <div class="folio-split-form">{% endif %}
    <div class="folio-form folio-editor">
        {% if notice %}
            <div class="folio-notice" role="alert">
                <p>{{ notice }}{% if reload_url %} <a href="{{ reload_url }}">{{ t('folio.form.reload') }}</a>{% endif %}</p>
            </div>
        {% endif %}
        {%- if multilingual|default(false) and ai_pending|default([]) is not empty %}<div class="folio-notice folio-ai-pending" role="status">{% for line in ai_pending %}<p>{{ line }}</p>{% endfor %}</div>{% endif %}
        {% if not framed and multilingual|default(false) %}
            {# The create drawer has no topbar: its language links stay above the form. #}
            <nav class="folio-languages folio-languages-editor" aria-label="{{ t('folio.form.editing_language') }}">
                {% for lang in languages %}
                    <a class="folio-language{% if lang.active %} is-active{% endif %}" href="{{ lang.url }}"{% if lang.active %} aria-current="true"{% endif %}>{{ lang.name }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        {% if locale_errors|default([]) is not empty %}
            <div class="folio-locale-errors" role="alert">
                <p>{{ t('folio.form.other_languages') }}</p>
                <ul>
                    {% for err in locale_errors %}
                        <li><a href="{{ err.url }}">{{ err.language }}</a>: {% if err.field %}{{ err.field }} — {% endif %}{{ err.messages|join(' ') }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        {% set form_attrs = {'id': record_form} %}
        {% if multipart|default(false) %}{% set form_attrs = form_attrs|merge({'enctype': 'multipart/form-data'}) %}{% endif %}
        {% if publishing and publishing.autosave_url %}
            {# Autosave: debounced htmx POST of the whole form, the side panel's form="…" controls too. Their
               events do not bubble to the form, so admin.js announces every edit of a control of the form
               (inside or outside, added later too) as "folio:edit" on it; the native submit stays a normal save. #}
            {% set form_attrs = form_attrs|merge({'hx-post': publishing.autosave_url, 'hx-trigger': 'folio:edit delay:3s, folio:save-now', 'hx-target': '#folio-save-state', 'hx-swap': 'outerHTML', 'hx-disabled-elt': 'button[type=submit][form=' ~ record_form ~ '], find button[type=submit]'}) %}
        {% endif %}
        {% set form = form_begin({action: action, csrf_token: csrf, attrs: form_attrs}) %}
        {{ form.begin()|raw }}
        {% if publishing %}
            <input type="hidden" name="_version" id="folio-version" value="{{ publishing.version }}">
        {% endif %}
        {# The form's default button (Enter in a field) saves, never one of the "Still correct" buttons that come first. #}
        {% if (can_save ?? true) %}<button type="submit" hidden tabindex="-1" aria-hidden="true"></button>{% endif %}
        {% set fields_html %}
        {# Without the right to save, the fields are shown read-only (display: contents, no layout change). #}
        <fieldset class="folio-fields"{% if not (can_save ?? true) %} disabled{% endif %}>
        {% if multilingual|default(false) %}
            <input type="hidden" name="_locale" value="{{ locale }}">
            <input type="hidden" name="_locales_submitted" value="1">
            {% if framed %}
                {# The visible-in boxes are in the side panel's Languages; the default language is always on. #}
                <input type="hidden" name="_locales[]" value="{{ default_locale }}">
            {% else %}
            <fieldset class="folio-visibility">
                <legend>{{ t('folio.form.visible_in') }}</legend>
                {% for lang in languages %}
                    <label class="folio-visibility-option">
                        {% if lang.code == default_locale %}
                            <input type="hidden" name="_locales[]" value="{{ lang.code }}">
                            <input type="checkbox" checked disabled> {{ lang.name }}
                        {% else %}
                            <input type="checkbox" name="_locales[]" value="{{ lang.code }}"{% if lang.code in available_in %} checked{% endif %}> {{ lang.name }}
                        {% endif %}
                    </label>
                {% endfor %}
            </fieldset>
            {% endif %}
        {% endif %}
        {% for row in rows %}
            {% if row.half %}<div class="folio-field-row">{% endif %}
            {% for field in row.fields %}{% include '@folio/admin/partials/_field.twig' %}{% endfor %}
            {% if row.half %}</div>{% endif %}
        {% endfor %}
        </fieldset>
        {% endset %}
        {% if seo_section|default(null) %}
            {# Content · SEO & sharing (admin.js initTabBox). Without JS both panels show, one after the other,
               the second under its heading; a refused share image opens the form on the SEO tab and marks it. #}
            <div class="folio-editor-tabs" data-folio-tabs>
                <div class="folio-tabs" role="tablist" aria-label="{{ t('folio.form.tabs') }}">
                    <button type="button" data-folio-tab="content"{% if not seo_section.error %} data-folio-tab-active{% endif %}>{{ t('folio.form.tab_content') }}</button>
                    <button type="button" data-folio-tab="seo"{% if seo_section.error %} data-folio-tab-active{% endif %}>{{ t('folio.form.tab_seo') }}{% if seo_section.error %}<span class="folio-tab-error" aria-hidden="true"></span><span class="folio-sr"> ({{ t('folio.form.tab_has_errors') }})</span>{% endif %}</button>
                </div>
                <div class="folio-tab-panel" data-folio-tabpanel="content" id="folio-tab-content">{{ fields_html }}</div>
                <div class="folio-tab-panel" data-folio-tabpanel="seo" id="folio-tab-seo">
                    <h2 class="folio-tab-heading">{{ t('folio.form.tab_seo') }}</h2>
                    {# Stored as the record's _seo meta; the boxes say "leave out", the stored flags are positive. #}
                    <fieldset class="folio-fields folio-seo-fields"{% if not (can_save ?? true) %} disabled{% endif %}>
                        <input type="hidden" name="_seo_submitted" value="1">
                        <p class="folio-seo-help">{{ t('folio.seo.help') }}</p>
                        <div class="form-group">
                            <label for="folio-seo-title">{{ t('folio.seo.share_title') }}</label>
                            <input type="text" id="folio-seo-title" name="_seo[title]" value="{{ seo_section.title }}">
                        </div>
                        <div class="form-group">
                            <label for="folio-seo-description">{{ t('folio.seo.share_description') }}</label>
                            <textarea id="folio-seo-description" name="_seo[description]" rows="3">{{ seo_section.description }}</textarea>
                        </div>
                        {% if seo_section.image is not null %}{{ seo_section.image|raw }}{% endif %}
                        <div class="folio-seo-flags">
                            <label class="folio-seo-flag"><input type="checkbox" name="_seo[noindex]" value="1"{% if seo_section.noindex %} checked{% endif %}> {{ t('folio.seo.noindex') }}</label>
                            <label class="folio-seo-flag"><input type="checkbox" name="_seo[exclude_sitemap]" value="1"{% if seo_section.exclude_sitemap %} checked{% endif %}> {{ t('folio.seo.exclude_sitemap') }}</label>
                            <label class="folio-seo-flag"><input type="checkbox" name="_seo[exclude_llms]" value="1"{% if seo_section.exclude_llms %} checked{% endif %}> {{ t('folio.seo.exclude_llms') }}</label>
                        </div>
                    </fieldset>
                </div>
            </div>
        {% else %}
            {{ fields_html }}
        {% endif %}
        {% if not framed and (can_save ?? true) %}
            {# The create drawer has no topbar: its buttons are the drawer's footer. #}
            <div class="folio-drawer-actions">
                {% if publishing %}
                    <button type="submit" class="btn {{ (can_publish ?? true) ? 'btn-secondary' : 'btn-primary' }}" data-busy-label="{{ t('folio.form.saving') }}">{{ t('folio.form.save_draft') }}</button>
                    {% if (can_publish ?? true) %}<button type="submit" class="btn btn-primary" name="_action" value="publish" data-busy-label="{{ t('folio.form.publishing') }}">{{ t('folio.form.publish') }}</button>{% endif %}
                {% else %}
                    <button type="submit" class="btn btn-primary" data-busy-label="{{ t('folio.form.saving') }}">{{ t('folio.common.save') }}</button>
                {% endif %}
            </div>
        {% endif %}
        {{ form_end()|raw }}
        {% if extras is not empty %}
        <section class="folio-form-extras" aria-label="{{ t('folio.form.more') }}">
        {% for panel in extras|filter(p => p.position == 'before') %}<section class="folio-panel"><h2 class="folio-panel-title">{{ panel.label }}</h2><div class="folio-panel-body">{{ panel.html|raw }}</div></section>{% endfor %}
        {% for panel in extras|filter(p => p.position == 'after') %}<section class="folio-panel"><h2 class="folio-panel-title">{{ panel.label }}</h2><div class="folio-panel-body">{{ panel.html|raw }}</div></section>{% endfor %}
        </section>
        {% endif %}
    </div>
    {% if previewable|default(false) %}</div>
    <div class="folio-resizer" data-folio-resizer role="separator" aria-orientation="vertical" aria-label="{{ t('folio.form.resize') }}" tabindex="0"></div>
    <section class="folio-split-stage" data-folio-stage data-preview-url="{{ preview_url }}" aria-label="{{ t('folio.form.live_preview') }}">
        {# The preview bar (board PageEditor): device switch · the address being previewed ("· draft" while it
           differs from what is live) · Copy preview link (the share route, then the clipboard; editor-frame.js) ·
           Open the live page · Focus. Without an address (a route value missing in this language) only the
           device switch and Focus. #}
        {% set bar = preview_bar|default(null) %}
        {% set share = publishing and publishing.share_url and bar and bar.address %}
        <div class="folio-preview-bar">
            <div class="folio-segmented folio-device-switch" role="group" aria-label="{{ t('folio.form.viewport') }}">
                {% for vp in [[t('folio.form.desktop'), '100%', 'ui-monitor'], [t('folio.form.tablet'), '768px', 'ui-tablet'], [t('folio.form.mobile'), '375px', 'ui-phone']] %}
                <button type="button" data-preview-viewport="{{ vp[1] }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" aria-label="{{ vp[0] }}" title="{{ vp[0] }}{{ loop.first ? '' : ' (' ~ vp[1] ~ ')' }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#{{ vp[2] }}"></use></svg></button>
                {% endfor %}
            </div>
            {% if bar and bar.address %}<span class="folio-preview-url{% if bar.draft %} is-draft{% endif %}" title="{{ bar.url }}"><span class="folio-preview-dot" aria-hidden="true"></span><span class="folio-preview-address">{{ bar.address }}</span>{% if bar.draft %}<span class="folio-preview-draft">{{ t('folio.form.preview_draft') }}</span>{% endif %}</span>{% else %}<span class="folio-preview-spacer"></span>{% endif %}
            {% if share %}<button type="button" class="btn btn-secondary btn-icon btn-sm folio-share-button" hx-post="{{ publishing.share_url }}" hx-target="#folio-share" hx-swap="outerHTML" hx-include="[name=_csrf_token], [name=_locale]" data-folio-share-copy data-text-copied="{{ bar.copied }}" aria-label="{{ t('folio.form.copy_preview_link') }}" title="{{ t('folio.form.copy_preview_link') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#link"></use></svg><span class="folio-share-status" aria-hidden="true"></span></button><span class="folio-sr" role="status" data-folio-share-announce></span>{% endif %}
            {% if bar and bar.address and bar.live_url %}<a class="btn btn-secondary btn-icon btn-sm folio-preview-open" href="{{ bar.live_url }}" target="_blank" rel="noopener" aria-label="{{ t('folio.form.open_live') }}" title="{{ t('folio.form.open_live') }}"><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-external"></use></svg></a>{% endif %}
            <button type="button" class="btn btn-ghost btn-sm folio-focus-toggle" data-folio-focus aria-pressed="false" title="{{ t('folio.form.focus_help') }}">{{ t('folio.form.focus') }}</button>
        </div>
        {% if share %}<div class="folio-share" id="folio-share"></div>{% endif %}
        <iframe class="folio-preview-frame" name="folio-preview-frame" title="{{ t('folio.form.live_preview_frame') }}"></iframe>
    </section>
    </div>{% endif %}
    </div>
    {% if framed %}{% include '@folio/admin/partials/_side_panel.twig' %}{% endif %}
    </div>
{% endblock %}
