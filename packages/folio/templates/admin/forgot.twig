{% extends '@folio/admin/_auth_layout.twig' %}
{% block title %}{{ t('folio.auth.forgot_title') }}{% endblock %}
{% block card %}
        <form class="folio-auth-card folio-auth-card-fixed" method="post" action="{{ forgot_action }}">
            {{ csrf_field()|raw }}
            <div class="folio-brand folio-auth-brand">{% include '@folio/admin/_logo.twig' %}<span class="folio-brand-name">Folio</span></div>
            <h1 class="folio-auth-title">{{ t('folio.auth.forgot_title') }}</h1>
            {% if sent %}
            <p class="folio-auth-lead">{{ t('folio.auth.forgot_sent') }}</p>
            {% else %}
            <p class="folio-auth-lead">{{ t('folio.auth.forgot_lead') }}</p>
            {% endif %}
            {% if error %}
                <div class="folio-alert folio-alert-error" role="alert">{{ error }}</div>
            {% endif %}
            {% if not sent %}
            <div class="form-group">
                <label for="email">{{ t('folio.auth.email') }}</label>
                <input type="email" name="email" id="email" autocomplete="username" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary">{{ t('folio.auth.send_link') }}</button>
            {% endif %}
            <p class="folio-auth-back"><a class="folio-auth-link" href="{{ login_url }}">{{ t('folio.auth.back_to_sign_in') }}</a></p>
        </form>
{% endblock %}
