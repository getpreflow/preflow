<section class="folio-asset-panel" aria-label="{{ t('folio.assets.details_label') }}">
    {% if notice %}<p class="folio-saved" role="status">{{ notice }}</p>{% endif %}
    {% if error %}<div class="folio-notice" role="alert"><p>{{ error }}</p></div>{% endif %}
    {% if note %}<p class="folio-asset-note" role="note">{{ note }}</p>{% endif %}
    {% if copy %}
    <div class="folio-asset-original">
        <p>
            {%- if copy.original %}{{ t('folio.assets.copy_of') }} <a href="{{ prefix }}/assets/{{ copy.original.id }}">{{ copy.original.label }}</a>
            {%- elseif copy.binned_original %}{{ t('folio.assets.copy_of') }} <a href="{{ prefix }}/assets/bin">{{ t('folio.assets.in_bin', {label: copy.binned_original}) }}</a>
            {%- else %}{{ t('folio.assets.copy_of_gone') }}{% endif %} · {{ t('folio.assets.made_by', {maker: copy.maker}) }}</p>
        {% if copy.stale %}<p class="folio-asset-stale" role="note">{{ t('folio.assets.original_changed_help') }}</p>{% endif %}
        {% if copy.can_remake and can('assets.edit') %}
        <form method="post" action="{{ prefix }}/assets/{{ asset.id }}/remake{{ back_q }}" data-confirm="{{ t('folio.assets.confirm_remake') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf }}">
            <button type="submit" class="btn btn-secondary">{{ t('folio.assets.remake') }}</button>
        </form>
        <p class="folio-help">{{ t('folio.assets.remake_help') }}</p>
        {% endif %}
    </div>
    {% endif %}
    <div class="folio-asset-columns">
        <div class="folio-asset-column">
            <div class="folio-asset-preview">
                {% if asset.kind == 'image' %}
                    <div class="folio-focal-picker" data-folio-focal>
                        <img src="{{ asset.thumb }}" alt="">
                        <span class="folio-focal-marker" aria-hidden="true"></span>
                    </div>
                    <p class="folio-help">{{ t('folio.assets.focal_help') }}</p>
                {% else %}
                    {% if asset.thumb %}<img class="folio-asset-preview-image" src="{{ asset.thumb }}" alt="">{% endif %}
                    <p><a href="{{ asset.url }}">{{ asset.name }}</a></p>
                {% endif %}
                <p class="folio-asset-meta">{{ asset.mime }} · {{ t('folio.assets.size_kb', {size: folio_number((asset.size / 1024)|round(0, 'ceil'))}) }}{% if edited %} · {{ delivered.width }}×{{ delivered.height }} ({{ t('folio.assets.original') }} {{ asset.width }}×{{ asset.height }}){% elseif asset.width %} · {{ asset.width }}×{{ asset.height }}{% endif %}</p>
                {% if edited %}
                    <p class="folio-asset-edit-actions"><a class="btn btn-ghost" href="{{ original_url }}" download>{{ t('folio.assets.download_original') }}</a></p>
                {% endif %}
                {% if swatches is not empty %}
                    <ul class="folio-swatches" aria-label="{{ t('folio.assets.colours') }}">
                        {% for s in swatches %}
                            <li class="folio-swatch{% if loop.first %} is-dominant{% endif %}">
                                <button type="button" class="folio-swatch-chip" data-copy="{{ s.hex }}" title="{{ t('folio.assets.copy_swatch', {label: s.label, value: s.hex}) }}">
                                    <svg class="folio-swatch-color" viewBox="0 0 1 1" aria-hidden="true" focusable="false"><rect width="1" height="1" fill="{{ s.hex }}"/></svg>
                                    <span class="folio-swatch-hex">{{ s.hex }}</span>
                                </button>
                                <button type="button" class="folio-swatch-rgb" data-copy="{{ s.rgb }}" title="{{ t('folio.assets.copy_value', {value: s.rgb}) }}">RGB</button>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            <div class="folio-asset-versions">
                <h2>{{ t('folio.assets.file') }}</h2>
                <p class="folio-asset-current">{{ t('folio.assets.version', {number: raw.version}) }} · <a href="{{ asset.url }}">{{ asset.url }}</a></p>
                {% if can('assets.edit') %}
                <form method="post" action="{{ prefix }}/assets/{{ asset.id }}/replace{{ back_q }}" enctype="multipart/form-data" class="folio-asset-replace">
                    <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                    <input type="file" name="file" aria-label="{{ t('folio.assets.new_file') }}">
                    <button type="submit" class="btn btn-secondary">{{ t('folio.assets.replace') }}</button>
                </form>
                <p class="folio-help">{{ t('folio.assets.replace_help') }}</p>
                {% endif %}
                {% if versions is not empty %}
                    <h3>{{ t('folio.assets.earlier_versions') }}</h3>
                    <ul class="folio-asset-version-list">
                        {% for v in versions %}
                            <li class="folio-asset-version">
                                <span class="folio-asset-version-number">v{{ v.number }}</span>
                                <span class="folio-asset-version-meta">{{ v.created_at ? folio_date(v.created_at, 'datetime') : '' }} · {{ t('folio.assets.size_kb', {size: folio_number((v.size / 1024)|round(0, 'ceil'))}) }}{% if v.width %} · {{ v.width }}×{{ v.height }}{% endif %}</span>
                                <a href="{{ v.url }}">{{ t('folio.assets.open') }}</a>
                                {% if can('assets.edit') %}
                                <form method="post" action="{{ prefix }}/assets/{{ asset.id }}/versions/{{ v.number }}/restore{{ back_q }}" data-confirm="{{ t('folio.assets.confirm_restore', {number: v.number}) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                                    <button type="submit" class="btn btn-ghost">{{ t('folio.common.restore') }}</button>
                                </form>
                                {% endif %}
                                {% if can('assets.delete') %}
                                <form method="post" action="{{ prefix }}/assets/{{ asset.id }}/versions/{{ v.number }}/delete{{ back_q }}" data-confirm="{{ t('folio.assets.confirm_delete_version', {number: v.number}) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                                    <button type="submit" class="btn btn-ghost">{{ t('folio.common.delete') }}</button>
                                </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
        <div class="folio-asset-column">
            <form method="post" action="{{ prefix }}/assets/{{ asset.id }}{{ back_q }}" class="folio-asset-form">
                <fieldset class="folio-fields"{% if not can('assets.edit') %} disabled{% endif %}>
                <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                <input type="hidden" name="focal_x" value="{{ asset.focal_x }}">
                <input type="hidden" name="focal_y" value="{{ asset.focal_y }}">
                {% for code in locales %}
                    <label class="folio-field">{{ locales|length > 1 ? t('folio.assets.alt_in', {locale: code}) : t('folio.assets.alt') }}
                        <input type="text" name="alt[{{ code }}]" value="{{ asset.alt[code]|default('') }}">
                    </label>
                {% endfor %}
                <label class="folio-field">{{ t('folio.assets.title') }}
                    <input type="text" name="title" value="{{ asset.title }}">
                </label>
                {% if asset.kind == 'video' %}
                    <label class="folio-field">{{ t('folio.assets.poster') }}
                        <select name="poster">
                            <option value="">{{ t('folio.common.none') }}</option>
                            {% for p in posters %}<option value="{{ p.id }}"{% if p.id == asset.poster %} selected{% endif %}>{{ p.label }}</option>{% endfor %}
                        </select>
                    </label>
                {% endif %}
                {% if fields is not empty %}
                    <input type="hidden" name="_extra" value="1">
                    {% for html in fields %}{{ html|raw }}{% endfor %}
                {% endif %}
                </fieldset>
                {% if can('assets.edit') %}<button type="submit" class="btn btn-primary">{{ t('folio.common.save') }}</button>{% endif %}
            </form>
        </div>
    </div>
    <div class="folio-asset-usage">
        <h2>{{ t('folio.assets.usage') }}</h2>
        {% if usage is empty %}
            <p>{{ t('folio.assets.unused') }}</p>
        {% else %}
            <p>{{ t('folio.assets.used_in', {}, usage|length) }}</p>
            <ul>{% for u in usage %}<li>{% if u.url %}<a href="{{ u.url }}">{{ u.label }}</a>{% else %}{{ u.label }}{% endif %}{% if u.where == 'published' %} {{ t('folio.assets.published_version') }}{% elseif u.where == 'revision' %} {{ t('folio.assets.earlier_revision') }}{% elseif u.where == 'poster' %} {{ t('folio.assets.as_poster') }}{% elseif u.where == 'binned_poster' %} {{ t('folio.assets.binned_poster') }}{% elseif u.where == 'copy' %} {{ t('folio.assets.as_copy') }}{% endif %}</li>{% endfor %}</ul>
        {% endif %}
    </div>
    {% if copies is not empty %}
    <div class="folio-asset-copies" id="copies">
        <h2>{{ t('folio.assets.copies') }}</h2>
        <ul class="folio-asset-copy-list">
            {% for c in copies %}
                <li class="folio-asset-copy" data-copy-id="{{ c.id }}">
                    <a class="folio-asset-copy-thumb" href="{{ prefix }}/assets/{{ c.id }}">{% if c.thumb %}<img src="{{ c.thumb }}" alt="" loading="lazy">{% else %}<span class="folio-asset-kind">{{ c.mime|split('/')|last|upper }}</span>{% endif %}</a>
                    <div class="folio-asset-copy-info">
                        <a href="{{ prefix }}/assets/{{ c.id }}">{{ c.label }}</a>
                        <span class="folio-asset-meta">{{ t('folio.assets.made_by', {maker: c.maker}) }} · {{ folio_date(c.created_at) }}</span>
                        {% if c.stale %}<span class="folio-asset-stale">{{ t('folio.assets.original_changed') }}</span>{% endif %}
                        <span class="folio-asset-meta">
                            {%- if c.usage is empty %}{{ t('folio.assets.unused') }}
                            {%- else %}{{ t('folio.assets.used_in', {}, c.usage|length) }} {% for u in c.usage %}{% if u.url %}<a href="{{ u.url }}">{{ u.label }}</a>{% else %}{{ u.label }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% endif -%}
                        </span>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
    {% if can('assets.delete') %}
    {# Only a usage that blocks a delete disables it: an earlier revision lets the file go into the bin. #}
    {% set blocked = usage|filter(u => u.blocks) is not empty %}
    <form method="post" action="{{ prefix }}/assets/{{ asset.id }}/delete{{ back_q }}" data-confirm="{{ t(has_bin ? 'folio.assets.confirm_bin' : 'folio.assets.confirm_delete') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf }}">
        <button type="submit" class="btn btn-danger"{% if blocked %} disabled title="{{ t('folio.assets.remove_first') }}"{% endif %}>{{ t('folio.common.delete') }}</button>
    </form>
    {% endif %}
</section>
