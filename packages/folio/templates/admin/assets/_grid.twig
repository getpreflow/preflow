<ul class="folio-asset-grid">
    {% for item in items %}
        <li class="folio-asset{% if item.id in selected %} is-selected{% endif %}" data-asset-id="{{ item.id }}">
            {% set href = prefix ~ '/assets/' ~ item.id %}
            <a class="folio-asset-thumb" href="{{ href }}"{% if not picker %} hx-get="{{ href }}" hx-target="#folio-asset-panel" hx-swap="innerHTML"{% endif %}>
                {% if item.thumb %}<img src="{{ item.thumb }}" alt="" loading="lazy">{% else %}<span class="folio-asset-kind">{{ item.mime|split('/')|last|upper }}</span>{% endif %}
            </a>
            <span class="folio-asset-label">{{ item.label }}</span>
            {% include '@folio/admin/assets/_pick.twig' %}
        </li>
    {% endfor %}
</ul>
