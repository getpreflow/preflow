{# Details | Edit image; the second only for editable images and users who may edit. tab: 'details' or 'edit'. #}
<nav class="folio-asset-tabs" aria-label="Asset">
    <a href="{{ prefix }}/assets/{{ asset.id }}{{ back_q }}"{% if tab == 'details' %} aria-current="page"{% endif %}>Details</a>
    {%- if editable and can('assets.edit') %}
    <a href="{{ prefix }}/assets/{{ asset.id }}/edit{{ back_q }}"{% if tab == 'edit' %} aria-current="page"{% endif %}>Edit image</a>
    {%- endif %}
</nav>
