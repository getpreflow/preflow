{# Details | Edit image | Versions · N; Edit image only for editable images and users who may edit. tab: 'details', 'edit' or 'versions'. #}
<nav class="folio-tabs" aria-label="{{ t('folio.assets.tabs') }}">
    <a href="{{ prefix }}/assets/{{ asset.id }}{{ back_q }}"{% if tab == 'details' %} aria-current="page"{% endif %}>{{ t('folio.assets.details') }}</a>
    {%- if editable and can('assets.edit') %}
    <a href="{{ prefix }}/assets/{{ asset.id }}/edit{{ back_q }}"{% if tab == 'edit' %} aria-current="page"{% endif %}>{{ t('folio.assets.edit_image') }}</a>
    {%- endif %}
    <a href="{{ prefix }}/assets/{{ asset.id }}/versions{{ back_q }}"{% if tab == 'versions' %} aria-current="page"{% endif %}>{{ t('folio.assets.versions') }} <span class="folio-tab-count">{{ folio_number(version_count) }}</span></a>
</nav>
