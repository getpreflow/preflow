{# The drop zone: a label for the upload form's file input; with admin.js files dropped here (or chosen) are uploaded one by one. #}
<label class="folio-asset-dropzone" for="folio-assets-files" data-folio-assets-drop>
    <svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-upload"></use></svg>
    <span class="folio-asset-drop-title">{{ t('folio.assets.drop_title') }}</span>
    <span class="folio-asset-drop-line" data-folio-assets-drop-status>{{ t('folio.assets.drop_line') }}</span>
</label>
