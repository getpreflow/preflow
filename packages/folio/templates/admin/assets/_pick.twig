{# The picker's Select: what the asset field's card shows (asset field, 0.75: name, kind and size, the
   alt-text warning, the focal point; Preflow\Folio\Media\AssetCard) travels with the pick. #}
{% if picker %}
    <button type="button" class="btn btn-secondary folio-asset-pick" data-folio-pick data-id="{{ item.id }}" data-thumb="{{ item.thumb }}" data-label="{{ item.label }}" data-meta="{{ item.card.meta }}" data-warn="{{ item.card.warn ? '1' : '0' }}" data-focal="{{ item.card.focal }}" data-multiple="{{ multiple ? '1' : '0' }}">{{ t('folio.assets.select') }}</button>
{% endif %}
