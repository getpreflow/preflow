{% extends '@folio/admin/_layout.twig' %}
{% import '@folio/admin/partials/_type_icon.twig' as types %}
{# The library's header pattern: its tile, the title and the count; the table and Restore as before. #}
{% set content_width = 'wide' %}
{% block title %}Folio — {{ t('folio.assets.bin') }}{% endblock %}
{% block title_lead %}{{ types.type_icon(family|default(null), 'ui-trash', 28) }}{% endblock %}
{% block page_title %}{{ t('folio.assets.bin') }}{% endblock %}
{% block title_after %}{% if items is not empty %}<span class="folio-title-count folio-assets-count">{{ t('folio.assets.bin_count', {}, total) }}</span>{% endif %}{% endblock %}
{% block actions %}<a class="btn btn-secondary" href="{{ prefix }}/assets">{{ t('folio.assets.back') }}</a>{% endblock %}
{% block content %}
<div class="folio-assets folio-asset-bin">
    {% if error %}<div class="folio-alert folio-alert-error" role="alert"><p>{{ error }}</p></div>{% endif %}
    {% if has_bin %}
        <p class="folio-help">{{ t('folio.assets.bin_help', {days: bin_days}) }}</p>
    {% else %}
        <p class="folio-help folio-assets-no-bin" role="note">{{ t('folio.assets.no_bin') }}</p>
    {% endif %}
    {% if items is empty %}
        {% include '@folio/admin/partials/_empty.twig' with {screen: 'assets-bin', title: t('folio.assets.bin_empty'), line: t('folio.assets.bin_empty_line')} only %}
    {% else %}
        <div class="folio-table-wrap">
        <table class="folio-table folio-asset-list">
            <thead><tr><th>{{ t('folio.assets.name') }}</th><th>{{ t('folio.assets.kind') }}</th><th>{{ t('folio.assets.size') }}</th><th>{{ t('folio.assets.binned_at') }}</th><th></th></tr></thead>
            <tbody>
            {% for item in items %}
                <tr data-asset-id="{{ item.id }}">
                    <td>{{ item.label }}{% if item.label != item.name %} <span class="folio-help">{{ item.name }}</span>{% endif %}{% if item.copy %} <span class="folio-asset-copy-mark">{{ item.copy_of ? t('folio.assets.copy_of_label', {label: item.copy_of}) : t('folio.assets.copy_mark') }}</span>{% endif %}</td>
                    <td>{{ t('folio.assets.kind_names.' ~ item.kind) }}</td>
                    <td>{{ t('folio.assets.size_kb', {size: folio_number((item.size / 1024)|round(0, 'ceil'))}) }}</td>
                    <td>{{ folio_date(item.binned_at) }}</td>
                    <td>
                        <form method="post" action="{{ prefix }}/assets/bin/{{ item.id }}/restore">
                            <input type="hidden" name="_csrf_token" value="{{ csrf }}">
                            <button type="submit" class="btn btn-secondary">{{ t('folio.assets.restore_from_bin') }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% include '@folio/admin/assets/_pager.twig' %}
    {% endif %}
</div>
{% endblock %}
