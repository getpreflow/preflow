{# The list view: the same facts as the cards, one row each; outside the picker the first column ticks the row for the selection bar. #}
<div class="folio-table-wrap">
<table class="folio-table folio-asset-list">
    <thead><tr>{% if not picker %}<th class="folio-bulk-cell"><input type="checkbox" data-folio-bulk-all aria-label="{{ t('folio.list.select_all') }}" hidden></th>{% endif %}<th></th><th>{{ t('folio.assets.name') }}</th><th>{{ t('folio.assets.kind') }}</th><th>{{ t('folio.assets.size') }}</th><th>{{ t('folio.assets.added') }}</th><th></th></tr></thead>
    <tbody>
    {% for item in items %}
        <tr class="folio-asset{% if item.id in selected %} is-selected{% endif %}" data-asset-id="{{ item.id }}">
            {% if not picker %}<td class="folio-bulk-cell"><input type="checkbox" name="ids[]" value="{{ item.id }}" form="folio-bulk" data-folio-bulk-item data-label="{{ item.label }}" data-kind="{{ item.kind }}" data-download="{{ item.original }}" aria-label="{{ t('folio.list.select_row', {label: item.label}) }}"></td>{% endif %}
            <td>{% if item.thumb %}<img class="folio-asset-mini" src="{{ item.thumb }}" alt="" loading="lazy">{% endif %}</td>
            <td>{% if picker %}{{ item.label }}{% else %}<a href="{{ prefix }}/assets/{{ item.id }}{{ detail_q }}">{{ item.label }}</a>{% endif %} {% include '@folio/admin/assets/_stack.twig' %}{% if item.label != item.name %}<span class="folio-asset-filename">{{ item.name }}</span>{% endif %}</td>
            <td>{{ t('folio.assets.kind_names.' ~ item.kind) }}{% if item.card.warn %} <span class="folio-badge is-warning">{{ t('folio.assets.no_alt') }}</span>{% endif %}</td>
            <td class="folio-asset-facts">{% include '@folio/admin/assets/_meta.twig' %}</td>
            <td>{{ folio_date(item.created_at) }}</td>
            <td>{% include '@folio/admin/assets/_pick.twig' %}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
