<table class="folio-table folio-asset-list">
    <thead><tr><th></th><th>Name</th><th>Kind</th><th>Size</th><th>Added</th><th></th></tr></thead>
    <tbody>
    {% for item in items %}
        <tr class="folio-asset{% if item.id in selected %} is-selected{% endif %}" data-asset-id="{{ item.id }}">
            <td>{% if item.thumb %}<img class="folio-asset-mini" src="{{ item.thumb }}" alt="" loading="lazy">{% endif %}</td>
            <td><a href="{{ prefix }}/assets/{{ item.id }}">{{ item.label }}</a></td>
            <td>{{ item.kind }}</td>
            <td>{{ (item.size / 1024)|round(0, 'ceil') }} KB{% if item.width %} · {{ item.width }}×{{ item.height }}{% endif %}</td>
            <td>{{ item.created_at|date('Y-m-d') }}</td>
            <td>{% include '@folio/admin/assets/_pick.twig' %}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
