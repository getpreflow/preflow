<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="csp-nonce" content="{{ csp_nonce() }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Folio{% endblock %}</title>
    {# No-flash theme: apply the stored choice before first paint. Plain inline
       script because action-mode responses bypass the asset collector. #}
    <script nonce="{{ csp_nonce() }}">
    (function () {
        try {
            var t = localStorage.getItem('folio-theme');
            if (t === 'light' || t === 'dark') {
                document.documentElement.setAttribute('data-theme', t);
            }
        } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="{{ folio_asset('admin.css') }}">
    {% if 'htmx.js' in editor_assets|default([]) or (page_assets|default(null)).htmx|default(false) %}
    {# htmx inserts its own indicator styles (needs the nonce); swapped admin fragments never run scripts. #}
    <meta name="htmx-config" content='{"inlineStyleNonce":"{{ csp_nonce() }}","allowScriptTags":false}'>
    {% endif %}
    {# admin.js on every admin page: confirm dialogs, toasts, the unsaved-changes guard. #}
    <script src="{{ folio_asset('admin.js') }}" defer></script>
    {% for a in editor_assets|default([]) %}
        {%- if a ends with '.css' %}<link rel="stylesheet" href="{{ folio_asset(a) }}">
        {%- elseif a ends with '.js' and a != 'admin.js' %}<script src="{{ folio_asset(a) }}" defer></script>
        {%- endif %}
    {% endfor %}
    {% if extension_assets_base|default(null) %}
    <meta name="folio-extension-assets" content="{{ extension_assets_base }}">
    {% endif %}
    {% if page_assets|default(null) %}
        {%- for href in page_assets.styles %}<link rel="stylesheet" href="{{ href }}">
        {% endfor -%}
        {%- set editor_urls = [] %}
        {%- for a in editor_assets|default([]) %}{% set editor_urls = editor_urls|merge([folio_asset(a)]) %}{% endfor %}
        {%- for src in page_assets.scripts %}{% if src not in editor_urls %}<script src="{{ src }}" defer nonce="{{ csp_nonce() }}"></script>
        {% endif %}{% endfor -%}
        {%- for src in page_assets.modules %}<script type="module" src="{{ src }}" nonce="{{ csp_nonce() }}"></script>
        {% endfor -%}
    {% endif %}
</head>
<body>
{% set icons = folio_asset('icons.svg') %}
<div class="folio-shell">
    <aside class="folio-sidebar">
        <a class="folio-brand" href="{{ prefix }}">
            {% include '@folio/admin/_logo.twig' %}
            <span class="folio-brand-name">Folio</span>
        </a>
        <nav class="folio-nav" aria-label="Folio">
            {% for nav_section in folio_nav() %}
                {% if nav_section.label != '' %}<span class="folio-nav-label">{{ nav_section.label }}</span>{% endif %}
                {% for item in nav_section.items %}
                    <a href="{{ item.url }}"{% if item.active %} class="active" aria-current="page"{% endif %}>
                        <svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#{{ item.icon }}"></use></svg><span>{{ item.label }}</span>{% if item.badge %}<span class="folio-nav-badge" aria-label="{{ item.badge }} waiting">{{ item.badge }}</span>{% endif %}
                    </a>
                {% endfor %}
            {% endfor %}
        </nav>
        <div class="folio-sidebar-foot">
            <div id="folio-theme-toggle" class="folio-theme-switch" role="group" aria-label="Theme">
                {% for choice, text in {'system': 'System', 'light': 'Light', 'dark': 'Dark'} %}
                    <button type="button" data-theme-choice="{{ choice }}" aria-pressed="false" title="{{ text }} theme">
                        <svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#{{ {'system': 'ui-monitor', 'light': 'ui-sun', 'dark': 'ui-moon'}[choice] }}"></use></svg>
                        <span class="folio-sr">{{ text }} theme</span>
                    </button>
                {% endfor %}
            </div>
            {% if folio_auth_enabled|default(false) and auth_check() %}
                {% set email = auth_user().email %}
                <div class="folio-user">{% set account_url = folio_account_url() %}{% if account_url %}<a class="folio-user-link" href="{{ account_url }}" title="Your account">{% endif %}
                    <span class="folio-avatar" aria-hidden="true">{{ email|first|upper }}</span>
                    <span class="folio-user-email" title="{{ email }}">{{ email }}</span>{% if account_url %}</a>{% endif %}
                    <form method="post" action="{{ prefix }}/logout" class="folio-logout">{{ csrf_field()|raw }}
                        <button type="submit" class="btn btn-ghost btn-icon" title="Log out">
                            <svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-logout"></use></svg><span class="folio-sr">Log out</span>
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </aside>
    <div class="folio-main">
        <header class="folio-topbar">
            <div class="folio-topbar-title">
                {% block breadcrumb %}{% endblock %}
                <h1>{% block page_title %}{% endblock %}</h1>
            </div>
            <div class="folio-actions">{% block actions %}{% endblock %}</div>
        </header>
        <main class="folio-content">
            {%- for type, message in folio_flashes() %}<div class="folio-alert folio-alert-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor -%}
            {% block content %}{% endblock %}</main>
    </div>
</div>
<div class="folio-toasts" aria-live="polite" data-folio-toasts></div>
<script nonce="{{ csp_nonce() }}">
(function () {
    var group = document.getElementById('folio-theme-toggle');
    if (!group) { return; }
    var root = document.documentElement;
    function current() {
        var t = root.getAttribute('data-theme');
        return t === 'light' || t === 'dark' ? t : 'system';
    }
    function mark() {
        var c = current();
        group.querySelectorAll('[data-theme-choice]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-theme-choice') === c ? 'true' : 'false');
        });
    }
    group.addEventListener('click', function (e) {
        var b = e.target.closest('[data-theme-choice]');
        if (!b) { return; }
        var choice = b.getAttribute('data-theme-choice');
        try {
            if (choice === 'system') { localStorage.removeItem('folio-theme'); } else { localStorage.setItem('folio-theme', choice); }
        } catch (err) {}
        if (choice === 'system') { root.removeAttribute('data-theme'); } else { root.setAttribute('data-theme', choice); }
        mark();
    });
    mark();
})();
</script>
</body>
</html>
