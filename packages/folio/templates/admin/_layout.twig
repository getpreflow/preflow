<!DOCTYPE html>
<html lang="{{ interface_locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="csp-nonce" content="{{ csp_nonce() }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# The admin is no public page: not indexed, and no GEO Markdown alternate (GEO skips noindex pages). #}
    <meta name="robots" content="noindex">
    <title>{% block title %}Folio{% endblock %}</title>
    {# No-flash theme and shell: apply the stored choices before first paint, and mark that script runs
       (folio-js: the user menu's panel starts closed while admin.js loads). Plain inline script because action-mode
       responses bypass the asset collector. #}
    <script nonce="{{ csp_nonce() }}">
    (function () {
        var root = document.documentElement;
        root.classList.add('folio-js');
        try {
            var t = localStorage.getItem('folio-theme');
            if (t === 'light' || t === 'dark') {
                root.setAttribute('data-theme', t);
            }
        } catch (e) {}
        // An editor's rail expanded to the sidebar earlier in this session (admin.js, data-shell-expand).
        try {
            if (sessionStorage.getItem('folio-shell') === 'sidebar') {
                root.setAttribute('data-folio-shell', 'sidebar');
            }
        } catch (e) {}
        // admin.js sets each user menu up (data-user-menu-ready) before load. If it never did (it failed
        // to load or stopped), drop folio-js so the no-script layout shows: the user panel open in place.
        window.addEventListener('load', function () {
            if (document.querySelector('[data-user-menu]:not([data-user-menu-ready])')) {
                root.classList.remove('folio-js');
            }
        });
    })();
    </script>
    <link rel="stylesheet" href="{{ folio_asset('admin.css') }}">
    {% if 'htmx.js' in editor_assets|default([]) or (page_assets|default(null)).htmx|default(false) %}
    {# htmx inserts its own indicator styles (needs the nonce); swapped admin fragments never run scripts. #}
    <meta name="htmx-config" content='{"inlineStyleNonce":"{{ csp_nonce() }}","allowScriptTags":false}'>
    {% endif %}
    {# admin.js on every admin page: confirm dialogs, toasts, the unsaved-changes guard. #}
    <script src="{{ folio_asset('admin.js') }}" defer></script>
    {% for a in editor_assets|default([]) %}
        {%- if a ends with '.css' %}<link rel="stylesheet" href="{{ folio_asset(a) }}">
        {%- elseif a ends with '.js' and a != 'admin.js' %}<script src="{{ folio_asset(a) }}" defer></script>
        {%- endif %}
    {% endfor %}
    {% if extension_assets_base|default(null) %}
    <meta name="folio-extension-assets" content="{{ extension_assets_base }}">
    {% endif %}
    {% if page_assets|default(null) %}
        {%- set editor_urls = [] %}
        {%- for a in editor_assets|default([]) %}{% set editor_urls = editor_urls|merge([folio_asset(a)]) %}{% endfor %}
        {%- for href in page_assets.styles %}{% if href not in editor_urls %}<link rel="stylesheet" href="{{ href }}">
        {% endif %}{% endfor -%}
        {%- for src in page_assets.scripts %}{% if src not in editor_urls %}<script src="{{ src }}" defer nonce="{{ csp_nonce() }}"></script>
        {% endif %}{% endfor -%}
        {%- for src in page_assets.modules %}<script type="module" src="{{ src }}" nonce="{{ csp_nonce() }}"></script>
        {% endfor -%}
    {% endif %}
</head>
<body data-folio-prefix="{{ prefix }}">
{% set icons = folio_asset('icons.svg') %}
{% set nav_sections = folio_nav() %}
{% set signed_in = folio_auth_enabled|default(false) and auth_check() %}
{# A template picks the editor rail with {% set shell = 'rail' %}; every other page has the sidebar. #}
{% set rail = shell|default('sidebar') == 'rail' %}
<div class="folio-shell{{ rail ? ' is-rail' : '' }}">
    {% if rail %}{% include '@folio/admin/partials/_rail.twig' %}{% endif %}
    <aside class="folio-sidebar">
        {# The site switcher: one site today, so a link to the dashboard (a site list comes with a second site). #}
        <div class="folio-site">
            <a class="folio-brand" href="{{ prefix }}">
                <span class="folio-brand-tile folio-ink">{% include '@folio/admin/_logo.twig' %}</span>
                <span class="folio-brand-text">
                    <span class="folio-brand-name">{{ folio_site.name }}</span>
                    <span class="folio-brand-env">{{ folio_site.env ? t('folio.layout.environment', {env: folio_site.env}) : 'Folio' }}</span>
                </span>
            </a>
            {% if rail %}
            <button type="button" class="btn btn-ghost btn-icon btn-sm folio-shell-collapse" data-shell-collapse aria-label="{{ t('folio.layout.collapse_nav') }}" title="{{ t('folio.layout.collapse_nav') }}">
                <svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#ui-panel"></use></svg>
            </button>
            {% endif %}
        </div>
        {# Each section with a heading opens and closes (<details>, open from the person's saved state);
           admin.js saves a toggle to data-nav-save. A closed section shows its items' badges summed. #}
        {%- macro nav_item(item, icons) %}
                    <a href="{{ item.url }}"{% if item.active %} class="active" aria-current="page"{% endif %}>
                        <svg class="folio-icon" aria-hidden="true"><use href="{{ icons }}#{{ item.icon }}"></use></svg><span>{{ item.label }}</span>{% if item.badge %}<span class="folio-nav-badge" aria-label="{{ t('folio.layout.waiting', {count: item.badge}) }}">{{ item.badge }}</span>{% endif %}
                    </a>
        {%- endmacro %}
        <nav class="folio-nav" aria-label="Folio"{% if signed_in %} data-nav-save="{{ prefix }}/_prefs/nav"{% endif %}>
            {% for nav_section in nav_sections %}
                {% if nav_section.name != '' and nav_section.label != '' %}
                <details class="folio-nav-section" data-section="{{ nav_section.name }}"{% if nav_section.open %} open{% endif %}>
                    <summary><span class="folio-nav-label">{{ nav_section.label }}</span>{% if nav_section.badge %}<span class="folio-nav-badge folio-nav-section-badge" aria-label="{{ t('folio.layout.waiting', {count: nav_section.badge}) }}">{{ nav_section.badge }}</span>{% endif %}<svg class="folio-icon folio-nav-marker" aria-hidden="true"><use href="{{ icons }}#ui-chevron"></use></svg></summary>
                    <div class="folio-nav-items">
                    {%- for item in nav_section.items %}{{ _self.nav_item(item, icons) }}{% endfor %}
                    </div>
                </details>
                {% else %}
                    <div class="folio-nav-items">
                    {%- for item in nav_section.items %}{{ _self.nav_item(item, icons) }}{% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        </nav>
        <div class="folio-sidebar-foot">
            {% if signed_in %}
                {% include '@folio/admin/partials/_user_menu.twig' with {menu_id: 'sidebar'} %}
            {% else %}
                {# No sign-in (auth is off): no user, so the theme switch stands on its own. #}
                {% include '@folio/admin/partials/_theme_switch.twig' with {switch_id: 'folio-theme-toggle'} %}
            {% endif %}
        </div>
    </aside>
    <div class="folio-main">
        <header class="folio-topbar">
            <div class="folio-topbar-title">
                {% block breadcrumb %}{% endblock %}
                <h1>{% block page_title %}{% endblock %}</h1>
                {# One muted line under the title: what the page is for (it replaces the help banners). #}
                {% set subtitle = block('subtitle') is defined ? block('subtitle')|trim : '' %}
                {% if subtitle != '' %}<p class="folio-subtitle">{{ subtitle|raw }}</p>{% endif %}
            </div>
            <div class="folio-actions">{% block actions %}{% endblock %}</div>
        </header>
        <main class="folio-content">
            {%- for type, message in folio_flashes() %}<div class="folio-alert folio-alert-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}{% set flash_link = folio_flash_link(type) %}{% if flash_link %} <a href="{{ flash_link.url }}">{{ flash_link.label }}</a>{% endif %}</div>{% endfor -%}
            {% block content %}{% endblock %}</main>
    </div>
</div>
<div class="folio-toasts" aria-live="polite" data-folio-toasts></div>
{% include '@folio/admin/_i18n.twig' %}
<script nonce="{{ csp_nonce() }}">
(function () {
    // The theme switches (the user menu's, or the sidebar's without sign-in): store the choice, mark the pressed button.
    var root = document.documentElement;
    function current() {
        var t = root.getAttribute('data-theme');
        return t === 'light' || t === 'dark' ? t : 'system';
    }
    function mark() {
        var c = current();
        document.querySelectorAll('[data-theme-switch] [data-theme-choice]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-theme-choice') === c ? 'true' : 'false');
        });
    }
    document.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('[data-theme-switch] [data-theme-choice]') : null;
        if (!b) { return; }
        var choice = b.getAttribute('data-theme-choice');
        try {
            if (choice === 'system') { localStorage.removeItem('folio-theme'); } else { localStorage.setItem('folio-theme', choice); }
        } catch (err) {}
        if (choice === 'system') { root.removeAttribute('data-theme'); } else { root.setAttribute('data-theme', choice); }
        mark();
    });
    mark();
})();
</script>
</body>
</html>
