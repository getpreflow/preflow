{% extends layout|default('@folio/admin/_layout.twig') %}
{% block title %}Folio — {{ t('folio.errors.forbidden_title') }}{% endblock %}
{% block page_title %}{{ t('folio.errors.forbidden_title') }}{% endblock %}
{% block content %}
    <div class="folio-empty">
        <svg class="folio-icon folio-empty-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-file"></use></svg>
        <p>{{ message }}</p>
        <p class="folio-muted">{{ t('folio.errors.forbidden_help') }}</p>
    </div>
{% endblock %}
