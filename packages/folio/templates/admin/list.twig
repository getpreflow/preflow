{% extends "@folio/admin/_layout.twig" %}
{% block title %}Folio — {{ label }}{% endblock %}
{% block page_title %}{{ label }}{% endblock %}
{% block actions %}
    {# The whole filtered and sorted list (not just this page); the bulk bar exports the ticked rows.
       The live search keeps the view in the URL (admin.js), so a click takes the query from there. #}
    {% if export_url|default(null) and has_records %}<a class="btn btn-secondary" href="{{ export_url }}{{ list_query ? '?' ~ list_query }}" data-folio-export-all="{{ export_url }}">{{ t('folio.common.export') }}</a>{% endif %}
    {% if can(type ~ '.create') %}<a class="btn btn-primary" href="{{ prefix }}/{{ type }}/new"><svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-plus"></use></svg>{{ t('folio.common.new') }}</a>{% endif %}
{% endblock %}
{% block content %}
    {% if has_records %}
        {# One GET form: works without JS; with JS the search narrows as you type (admin.js). #}
        <form class="folio-list-toolbar" method="get" action="{{ list.base }}" role="search" data-folio-list-form>
            <label class="folio-list-search">
                <span class="folio-sr">{{ t('folio.list.search_label', {label: folio_noun(label)}) }}</span>
                <svg class="folio-icon" aria-hidden="true"><use href="{{ folio_asset('icons.svg') }}#ui-search"></use></svg>
                <input type="search" name="q" value="{{ list.q }}" placeholder="{{ t('folio.common.search_placeholder') }}" autocomplete="off" data-folio-list-search>
            </label>
            {% for input in list.hidden %}<input type="hidden" name="{{ input.name }}" value="{{ input.value }}">{% endfor %}
            {% if list.filters is not empty %}
                <details class="folio-filter-menu">
                    <summary class="btn btn-secondary btn-sm">{{ t('folio.list.add_filter') }}</summary>
                    <div class="folio-filter-panel">
                        {% for filter in list.filters %}
                            <div class="folio-filter-field">
                                {% if filter.kind == 'date' %}
                                    <span class="folio-filter-label">{{ filter.label }}</span>
                                    <span class="folio-filter-range">
                                        <input type="date" name="f[{{ filter.name }}][from]" aria-label="{{ t('folio.list.from', {label: filter.label}) }}">
                                        <span aria-hidden="true">–</span>
                                        <input type="date" name="f[{{ filter.name }}][to]" aria-label="{{ t('folio.list.until', {label: filter.label}) }}">
                                    </span>
                                {% elseif filter.kind == 'relation-search' %}
                                    <label class="folio-filter-label" for="folio-filter-{{ filter.name }}">{{ filter.label }}</label>
                                    {# Too many records to list: data-folio-list-relation is the hook for a remote search. #}
                                    <input type="text" id="folio-filter-{{ filter.name }}" name="f[{{ filter.name }}]" placeholder="{{ t('folio.common.search_placeholder') }}" autocomplete="off" data-folio-list-relation="{{ filter.target }}" data-folio-relation-url="{{ prefix }}/_relation/{{ filter.target }}">
                                {% else %}
                                    <label class="folio-filter-label" for="folio-filter-{{ filter.name }}">{{ filter.label }}</label>
                                    <select id="folio-filter-{{ filter.name }}" name="f[{{ filter.name }}]">
                                        <option value="">{{ t('folio.common.any') }}</option>
                                        {% for value, text in filter.options %}<option value="{{ value }}">{{ text }}</option>{% endfor %}
                                    </select>
                                {% endif %}
                            </div>
                        {% endfor %}
                        <button type="submit" class="btn btn-primary btn-sm">{{ t('folio.common.apply') }}</button>
                    </div>
                </details>
            {% endif %}
            <button type="submit" class="btn btn-secondary btn-sm folio-list-submit" data-folio-list-submit>{{ t('folio.common.search') }}</button>
        </form>
    {% endif %}
    <div class="folio-list-results" data-folio-list-results>
        {% include '@folio/admin/_list_results.twig' %}
    </div>
{% endblock %}
