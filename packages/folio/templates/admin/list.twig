{% extends "@folio/admin/_layout.twig" %}
{% block title %}Folio — {{ label }}{% endblock %}
{% block page_title %}{{ label }}{% endblock %}
{% block actions %}
    <a class="btn btn-primary" href="{{ prefix }}/{{ type }}/new">New</a>
{% endblock %}
{% block content %}
    {% if rows is empty %}
        <div class="folio-empty">
            <p>No records yet.</p>
            <a class="btn btn-primary" href="{{ prefix }}/{{ type }}/new">Create one</a>
        </div>
    {% else %}
        <table class="folio-table">
            <thead><tr>{% for name, heading in columns %}<th>{{ heading }}</th>{% endfor %}{% if multilingual|default(false) %}<th>Languages</th>{% endif %}<th></th></tr></thead>
            <tbody>
            {% for row in rows %}
                {% set first = loop.first %}
                {% set last = loop.last %}
                <tr>
                    {% for name, heading in columns %}<td>{{ row.cells[name] }}</td>{% endfor %}
                    {% if multilingual|default(false) %}<td>{% for badge in row.languages %}<span class="folio-badge{% if 'missing' in badge %} is-incomplete{% endif %}">{{ badge }}</span> {% endfor %}</td>{% endif %}
                    <td>
                        <div class="folio-row-actions">
                            {% if orderable %}
                                {% for direction, text in {'up': 'Move up', 'down': 'Move down'} %}
                                    <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/move">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                        <input type="hidden" name="direction" value="{{ direction }}">
                                        <button type="submit" class="btn btn-ghost" aria-label="{{ text }}"{% if (direction == 'up' and first) or (direction == 'down' and last) %} disabled{% endif %}>{{ direction == 'up' ? '↑' : '↓' }}</button>
                                    </form>
                                {% endfor %}
                            {% endif %}
                            <a class="btn btn-ghost" href="{{ prefix }}/{{ type }}/{{ row.id }}/edit">Edit</a>
                            <form method="post" action="{{ prefix }}/{{ type }}/{{ row.id }}/delete" data-confirm="Delete this record?">
                                <input type="hidden" name="_csrf_token" value="{{ csrf|default('') }}">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
