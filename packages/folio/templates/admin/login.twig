<!DOCTYPE html>
<html lang="{{ interface_locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Folio — {{ t('folio.auth.sign_in') }}</title>
    <script nonce="{{ csp_nonce() }}">
    (function () {
        try {
            var t = localStorage.getItem('folio-theme');
            if (t === 'light' || t === 'dark') {
                document.documentElement.setAttribute('data-theme', t);
            }
        } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="{{ folio_asset('admin.css') }}">
</head>
<body>
<div class="folio-auth">
    <aside class="folio-auth-art" aria-hidden="true">
        {% include '@folio/admin/_auth_pattern.twig' %}
        <div class="folio-auth-hello">
            {% include '@folio/admin/_logo.twig' with {size: 'xl'} %}
            <p class="folio-auth-word">Folio</p>
            <p class="folio-auth-line">{{ t('folio.auth.tagline') }}<span class="folio-auth-caret"></span></p>
        </div>
    </aside>
    <main class="folio-auth-main">
        <form class="folio-auth-card" method="post" action="{{ login_action|default('') }}">
            {{ csrf_field()|raw }}
            <div class="folio-brand folio-auth-brand">{% include '@folio/admin/_logo.twig' %}<span class="folio-brand-name">Folio</span></div>
            <h1 class="folio-auth-title">{{ t('folio.auth.sign_in') }}</h1>
            <p class="folio-auth-lead">{{ t('folio.auth.welcome') }}</p>
            {% if login_error|default('') %}
                <div class="folio-alert folio-alert-error" role="alert">{{ login_error }}</div>
            {% endif %}
            <div class="form-group">
                <label for="email">{{ t('folio.auth.email') }}</label>
                <input type="email" name="email" id="email" autocomplete="username" required autofocus>
            </div>
            <div class="form-group">
                <label for="password">{{ t('folio.auth.password') }}</label>
                <input type="password" name="password" id="password" autocomplete="current-password" required>
            </div>
{% if remember_offered|default(false) or forgot_url|default('') %}
            <div class="folio-auth-row">
{% if remember_offered|default(false) %}
                <label class="folio-auth-check"><input type="checkbox" name="remember" value="1"> {{ t('folio.auth.remember') }}</label>
{% endif %}
{% if forgot_url|default('') %}
                <a class="folio-auth-link" href="{{ forgot_url }}">{{ t('folio.auth.forgot_link') }}</a>
{% endif %}
            </div>
{% endif %}
            <button type="submit" class="btn btn-primary">{{ t('folio.auth.sign_in') }}</button>
        </form>
        <p class="folio-auth-foot">{{ t('folio.auth.powered_by') }} <a href="https://preflow.dev" rel="noopener">Preflow</a></p>
    </main>
</div>
</body>
</html>
