{
    "key": "code",
    "table": "code",
    "storage": "codes",
    "id_field": "uuid",
    "label": "Codes",
    "publishing": false,
    "transfer": false,
    "fields": {
        "purpose": { "type": "string", "label": "Purpose", "validate": ["required"] },
        "code": { "type": "string", "label": "Code" },
        "label": { "type": "string", "label": "Label" },
        "expires_at": { "type": "date", "label": "Expires at", "time": true },
        "max_uses": { "type": "number", "label": "Max uses" },
        "uses": { "type": "number", "label": "Uses" },
        "revoked_at": { "type": "string", "label": "Revoked at" },
        "payload": { "type": "string", "label": "Payload (JSON)" },
        "form": { "type": "select", "label": "Form", "options": { "readable": "Readable", "random": "Random" }, "validate": ["required", "in:readable,random"] },
        "recipient": { "type": "string", "label": "Recipient" }
    }
}
