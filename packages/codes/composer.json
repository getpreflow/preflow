{
    "name": "preflow/codes",
    "description": "Preflow codes — readable and random codes that grant something for one purpose",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.20 || @dev",
        "preflow/data": "^0.21 || @dev",
        "preflow/folio": "^0.20 || @dev",
        "preflow/i18n": "^0.26 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Codes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Codes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "folio": {
            "extension": "Preflow\\Codes\\Extension"
        },
        "preflow": {
            "translations": {
                "codes": { "path": "lang", "scope": "admin" }
            }
        }
    }
}
