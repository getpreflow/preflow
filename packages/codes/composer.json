{
    "name": "preflow/codes",
    "description": "Preflow codes — readable and random codes that grant something for one purpose",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.20 || @dev",
        "preflow/data": "^0.42 || @dev",
        "preflow/validation": "^0.26 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "conflict": {
        "preflow/core": "<0.38",
        "preflow/data": "<0.66.1",
        "preflow/folio": "<0.40"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Codes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Codes\\Tests\\": "tests/"
        }
    }
}
