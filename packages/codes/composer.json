{
    "name": "preflow/codes",
    "description": "Preflow codes — readable and random codes that grant something for one purpose",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.20 || @dev",
        "preflow/data": "^0.21 || @dev",
        "preflow/i18n": "^0.37 || @dev",
        "preflow/notify": "^0.25 || @dev",
        "preflow/view": "^0.1 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "conflict": {
        "preflow/i18n": "<0.37"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Codes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Codes\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "translations": {
                "codes-mail": {
                    "path": "lang",
                    "scope": "public"
                }
            }
        }
    }
}
