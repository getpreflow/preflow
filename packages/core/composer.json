{
    "name": "preflow/core",
    "description": "Preflow framework core — kernel, container, config, middleware, error handling",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "conflict": {
        "preflow/auth": "<0.38",
        "preflow/data": "<0.59",
        "preflow/htmx": "<0.46",
        "preflow/i18n": "<0.46",
        "preflow/routing": "<0.59",
        "preflow/view": "<0.58",
        "preflow/twig": "<0.50",
        "preflow/blade": "<0.50"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Core\\Tests\\": "tests/"
        }
    }
}
