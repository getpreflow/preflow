{
    "name": "preflow/testing",
    "description": "Preflow testing — test utilities for components, routes, data",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "phpunit/phpunit": "^11.0",
        "preflow/core": "^0.88.0 || @dev",
        "preflow/routing": "^0.1 || @dev",
        "preflow/view": "^0.86.0 || @dev",
        "preflow/components": "^0.86.0 || @dev",
        "preflow/data": "^0.84.0 || @dev",
        "preflow/htmx": "^0.88.0 || @dev",
        "preflow/auth": "^0.1 || @dev",
        "preflow/i18n": "^0.1 || @dev",
        "nyholm/psr7": "^1.8"
    },
    "conflict": {
        "preflow/auth": "<0.81.0",
        "preflow/core": "<0.88.0",
        "preflow/data": "<0.84.0",
        "preflow/htmx": "<0.88.0",
        "preflow/view": "<0.86.0",
        "preflow/components": "<0.86.0"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Testing\\Tests\\": "tests/"
        }
    }
}
