{
    "name": "preflow/fields",
    "description": "Preflow fields — field types as core values: parsing, checks, storage and template helpers (link, email, phone, date and time, colour, video embed, table, code, JSON, location)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "preflow/core": "^0.84.0 || @dev",
        "preflow/data": "^0.91.0 || @dev",
        "preflow/validation": "^0.91.0 || @dev",
        "preflow/view": "^0.91.0 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/blocks": "^0.91.0 || @dev",
        "preflow/testing": "^0.91.0 || @dev"
    },
    "suggest": {
        "preflow/blocks": "The options of these field types in block fields are checked when the block registry is built"
    },
    "conflict": {
        "preflow/blocks": "<0.91.0",
        "preflow/core": "<0.84.0",
        "preflow/data": "<0.91.0",
        "preflow/validation": "<0.91.0",
        "preflow/view": "<0.91.0"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Fields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Fields\\Tests\\": "tests/"
        }
    }
}
