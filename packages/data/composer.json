{
    "name": "preflow/data",
    "description": "Preflow data — storage drivers, models, migrations",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "preflow/core": "^0.58 || @dev",
        "preflow/validation": "^0.42 || @dev"
    },
    "conflict": {
        "preflow/core": "<0.58",
        "preflow/validation": "<0.42"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/testing": "^0.64 || @dev"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Data\\Tests\\": "tests/"
        }
    }
}
