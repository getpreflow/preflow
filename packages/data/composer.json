{
    "name": "preflow/data",
    "description": "Preflow data — storage drivers, models, migrations",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "preflow/core": "^0.84.0 || @dev",
        "preflow/validation": "^0.92.0 || @dev"
    },
    "conflict": {
        "preflow/core": "<0.84.0",
        "preflow/validation": "<0.92.0",
        "preflow/folio": "<0.93.0",
        "preflow/publishing": "<0.72",
        "preflow/devtools": "<0.80"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/testing": "^0.64 || @dev"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Data\\Tests\\": "tests/"
        }
    }
}
