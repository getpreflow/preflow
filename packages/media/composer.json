{
    "name": "preflow/media",
    "description": "Preflow media — the asset library: uploads, responsive image variants, private files",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "nyholm/psr7": "^1.8",
        "preflow/core": "^0.54 || @dev",
        "preflow/data": "^0.76 || @dev",
        "preflow/routing": "^0.59 || @dev",
        "preflow/view": "^0.67 || @dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "preflow/i18n": "^0.68 || @dev",
        "preflow/devtools": "^0.34 || @dev"
    },
    "suggest": {
        "preflow/i18n": "Per-language alt text for assets, and alt texts as a machine-translation source",
        "preflow/devtools": "The media:* commands"
    },
    "conflict": {
        "preflow/core": "<0.54",
        "preflow/data": "<0.76",
        "preflow/i18n": "<0.47",
        "preflow/routing": "<0.59",
        "preflow/view": "<0.67"
    },
    "autoload": {
        "psr-4": {
            "Preflow\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preflow\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "preflow": {
            "commands": [
                "Preflow\\Media\\Console\\BinCommand",
                "Preflow\\Media\\Console\\CleanupCommand",
                "Preflow\\Media\\Console\\ColorsCommand",
                "Preflow\\Media\\Console\\PreviewsCommand",
                "Preflow\\Media\\Console\\VariantsCommand",
                "Preflow\\Media\\Console\\VersionsPruneCommand"
            ]
        }
    }
}
