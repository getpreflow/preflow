{
    "name": "preflow/monorepo",
    "description": "Preflow framework monorepo — development only",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "chillerlan/php-qrcode": "^5.0",
        "illuminate/filesystem": "^12.56",
        "illuminate/view": "^12.56",
        "nyholm/psr7-server": "^1.1",
        "openspout/openspout": "^4",
        "phpunit/phpunit": "^11.0",
        "preflow/auth": "@dev",
        "preflow/blade": "@dev",
        "preflow/codes": "@dev",
        "preflow/components": "@dev",
        "preflow/core": "@dev",
        "preflow/data": "@dev",
        "preflow/devtools": "@dev",
        "preflow/folio": "@dev",
        "preflow/form": "@dev",
        "preflow/htmx": "@dev",
        "preflow/i18n": "@dev",
        "preflow/media": "@dev",
        "preflow/members": "@dev",
        "preflow/notify": "@dev",
        "preflow/rbac": "@dev",
        "preflow/roles": "@dev",
        "preflow/routing": "@dev",
        "preflow/testing": "@dev",
        "preflow/twig": "@dev",
        "preflow/validation": "@dev",
        "preflow/view": "@dev",
        "symfony/mailer": "^7.3 || ^8.0",
        "symfony/notifier": "^7.3 || ^8.0"
    },
    "scripts": {
        "test:mysql": "bin/test-mysql"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/auth",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/components",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/core",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/data",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/htmx",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/routing",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/view",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/blade",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/twig",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/i18n",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/testing",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/devtools",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/folio",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/form",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/validation",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/notify",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/roles",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/rbac",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/codes",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/media",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "packages/members",
            "options": { "symlink": true }
        }
    ],
    "autoload": {},
    "autoload-dev": {
        "psr-4": {
            "App\\": "packages/skeleton/app/",
            "Tests\\": "packages/skeleton/tests/",
            "Preflow\\Auth\\Tests\\": "packages/auth/tests/",
            "Preflow\\DevTools\\Tests\\": "packages/devtools/tests/",
            "Preflow\\Codes\\Tests\\": "packages/codes/tests/",
            "Preflow\\Folio\\Tests\\": "packages/folio/tests/",
            "Preflow\\Form\\Tests\\": "packages/form/tests/",
            "Preflow\\I18n\\Tests\\": "packages/i18n/tests/",
            "Preflow\\Media\\Tests\\": "packages/media/tests/",
            "Preflow\\Members\\Tests\\": "packages/members/tests/",
            "Preflow\\Notify\\Tests\\": "packages/notify/tests/",
            "Preflow\\Rbac\\Tests\\": "packages/rbac/tests/",
            "Preflow\\Roles\\Tests\\": "packages/roles/tests/",
            "Preflow\\Validation\\Tests\\": "packages/validation/tests/",
            "Preflow\\Examples\\FolioDemo\\Tests\\": "examples/folio-demo/tests/",
            "Preflow\\Examples\\FolioDemo\\": "examples/folio-demo/app/",
            "App\\Folio\\": "examples/folio-demo/app/Folio/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
