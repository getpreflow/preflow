#!/usr/bin/env bash
# Runs the MySQL-tagged tests with the local credentials from .env.mysql-test.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if [ ! -f .env.mysql-test ]; then
    echo "Create .env.mysql-test with MYSQL_HOST, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASS" >&2
    exit 1
fi

set -a
# shellcheck disable=SC1091
. ./.env.mysql-test
set +a

exec vendor/bin/phpunit --group mysql "$@"
