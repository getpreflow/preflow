#!/usr/bin/env php
<?php

/*
 * Derives TextMatch's fold table (packages/data/src/Text/fold-table.php) from a MySQL/MariaDB
 * server's accent-sensitive, case-insensitive collation, so JSON and SQLite match text exactly as
 * that server's LIKE does, character by character.
 *
 * Every assigned code point (but controls, surrogates and private use) is grouped by its weights
 * under the collation; each group folds to one member: the one most members reach by case
 * folding after compatibility (NFKC, single-character) mapping. Every character is then checked
 * with LIKE against its fold, both ways. Needs ext-intl and the MYSQL_* settings of
 * .env.mysql-test (as `composer test:mysql`).
 *
 * Usage: bin/text-fold-table [collation]   (default: the first of MysqlDialect::MATCH_COLLATIONS the server has)
 */

declare(strict_types=1);

use Preflow\Data\Driver\MysqlDialect;
use Preflow\Data\Tests\Text\CollationProbe;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';
require $root . '/packages/data/tests/Text/CollationProbe.php';

if (is_file($root . '/.env.mysql-test')) {
    foreach (file($root . '/.env.mysql-test', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        if (preg_match('/^\s*([A-Z_]+)\s*=\s*"?(.*?)"?\s*$/', $line, $m) === 1 && getenv($m[1]) === false) {
            putenv("{$m[1]}={$m[2]}");
        }
    }
}
$pdo = new PDO(
    sprintf('mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4', getenv('MYSQL_HOST'), getenv('MYSQL_PORT') ?: '3306', getenv('MYSQL_DATABASE')),
    (string) getenv('MYSQL_USER'),
    (string) getenv('MYSQL_PASS'),
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
);
$collation = $argv[1] ?? MysqlDialect::serverMatchCollation($pdo);
if ($collation === null) {
    fwrite(STDERR, "The server has none of MysqlDialect::MATCH_COLLATIONS.\n");
    exit(1);
}
$probe = new CollationProbe($pdo);

$natural = CollationProbe::compatibilityFold(...);

$points = CollationProbe::codePoints();
$dialect = new MysqlDialect($collation);
$probed = [];
foreach ($points as $cp) {
    $probed[mb_chr($cp, 'UTF-8')] = true;
}

// Union-find over the characters LIKE takes as equal (both ways).
$parent = [];
$find = static function (string $c) use (&$parent, &$find): string {
    if (!isset($parent[$c]) || $parent[$c] === $c) {
        return $c;
    }

    return $parent[$c] = $find($parent[$c]);
};
$union = static function (string $a, string $b) use (&$parent, $find): void {
    $ra = $find($a);
    $rb = $find($b);
    if ($ra !== $rb) {
        $parent[$ra] ??= $ra;
        $parent[$rb] = $ra;
    }
};
/** @param list<array{string, string}> $pairs @return list<bool> equal both ways */
$equal = static function (array $pairs) use ($probe, $dialect): array {
    if ($pairs === []) {
        return [];
    }
    $both = [];
    foreach ($pairs as [$a, $b]) {
        $both[] = [$a, $b];
        $both[] = [$b, $a];
    }
    $answers = $probe->likes($both, $dialect);
    $result = [];
    foreach ($pairs as $i => $_) {
        $result[] = $answers[2 * $i] && $answers[2 * $i + 1];
    }

    return $result;
};
$vote = static function (array $members) use ($natural): string {
    $votes = [];
    foreach ($members as $member) {
        $target = $natural($member);
        if (in_array($target, $members, true)) {
            $votes[$target] = ($votes[$target] ?? 0) + 1;
        }
    }
    if ($votes === []) {
        return $members[0];
    }
    $best = max($votes);
    $tied = array_keys(array_filter($votes, static fn (int $n): bool => $n === $best));
    usort($tied, static fn (string $a, string $b): int => mb_ord($a, 'UTF-8') <=> mb_ord($b, 'UTF-8'));

    return (string) $tied[0];
};

// Candidates: each character's relatives (compatibility fold, lower and upper case) ...
$pairs = [];
foreach (array_keys($probed) as $char) {
    foreach (CollationProbe::relatives((string) $char) as $target) {
        if ($target !== $char && isset($probed[$target])) {
            $pairs[] = [(string) $char, $target];
        }
    }
}
foreach ($equal($pairs) as $i => $same) {
    if ($same) {
        $union($pairs[$i][0], $pairs[$i][1]);
    }
}
// ... and the characters of equal weights, split until LIKE agrees.
$pending = [];
foreach ($probe->weights($points, $collation) as $cp => $weight) {
    $pending[$weight][] = mb_chr($cp, 'UTF-8');
}
$pending = array_values(array_filter($pending, static fn (array $g): bool => count($g) > 1));
while ($pending !== []) {
    $pairs = [];
    $owner = [];
    foreach ($pending as $g => $members) {
        $rep = $vote($members);
        foreach ($members as $member) {
            if ($member !== $rep) {
                $pairs[] = [$member, $rep];
                $owner[] = $g;
            }
        }
    }
    $rest = [];
    foreach ($equal($pairs) as $i => $same) {
        if ($same) {
            $union($pairs[$i][0], $pairs[$i][1]);
        } else {
            $rest[$owner[$i]][] = $pairs[$i][0];
        }
    }
    $pending = array_values(array_filter($rest, static fn (array $g): bool => count($g) > 1));
}

$classes = [];
foreach (array_keys($parent) as $char) {
    $classes[$find((string) $char)][] = (string) $char;
}
$folds = [];
foreach ($classes as $members) {
    $members = array_values(array_unique($members));
    $rep = $vote($members);
    foreach ($members as $member) {
        if ($member !== $rep) {
            $folds[$member] = $rep;
        }
    }
}
uksort($folds, static fn (string $a, string $b): int => mb_ord($a, 'UTF-8') <=> mb_ord($b, 'UTF-8'));

// Every folded character must match its fold both ways on the server.
$pairs = [];
foreach ($folds as $char => $fold) {
    $pairs[] = [(string) $char, $fold];
}
$refused = [];
foreach ($equal($pairs) as $i => $same) {
    if (!$same) {
        $refused[] = sprintf('U+%04X ~ U+%04X', mb_ord($pairs[$i][0], 'UTF-8'), mb_ord($pairs[$i][1], 'UTF-8'));
    }
}
if ($refused !== []) {
    fwrite(STDERR, "LIKE is not transitive here:\n" . implode("\n", array_slice($refused, 0, 50)) . "\n");
    exit(1);
}

$escape = static fn (string $s): string => '"' . preg_replace_callback(
    '/[^\x21\x23-\x5B\x5D-\x7E]/u',
    static fn (array $m): string => sprintf('\u{%04X}', mb_ord($m[0], 'UTF-8')),
    $s,
) . '"';
$lines = [];
foreach ($folds as $char => $fold) {
    $lines[] = '    ' . $escape((string) $char) . ' => ' . $escape($fold) . ',';
}
$source = sprintf('%s, %s, %d code points', $probe->version(), $collation, count($points));
$php = "<?php\n\n"
    . "// Generated by bin/text-fold-table from {$source}. Do not edit by hand.\n"
    . "// Each character that LIKE takes as another one under that collation => the one it folds to.\n\n"
    . "declare(strict_types=1);\n\n"
    . "return [\n" . implode("\n", $lines) . "\n];\n";
file_put_contents($root . '/packages/data/src/Text/fold-table.php', $php);
fwrite(STDOUT, sprintf("%d folds from %s\n", count($folds), $source));
